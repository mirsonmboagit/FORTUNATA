# Copie este ficheiro para config/.env e preencha os valores reais.
# Nunca envie config/.env para o repositorio.

# Configuracao da API local/remota.
API_KEY=troque-esta-chave
API_HOST=0.0.0.0
API_PORT=8080
API_BASE_URL=http://IP_DO_SERVIDOR:8080
DB_MODE=remote_strict
LOG_LEVEL=INFO

# Servidor de envio dos codigos de verificacao e recuperacao.
SMTP_HOST=monstamboa@gmail.com
SMTP_PORT=587
SMTP_USERNAME=mirson_mboa
SMTP_PASSWORD=senha_ou_token_smtp
SMTP_FROM_EMAIL=recuperacao@exemplo.com
SMTP_FROM_NAME=SIGE MPE
SMTP_USE_TLS=true
SMTP_USE_SSL=false
