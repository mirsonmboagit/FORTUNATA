#:kivy 2.0

<ExpiredBatchRow>:
    radius: [dp(8)]
    elevation: 0

<LossesFloatingScannerPanel>:
    radius: [dp(14)]
    elevation: 4

<LossesScreen>:
    name: "losses"
    md_bg_color: app.theme_tokens['surface']

    FloatLayout:
        MDBoxLayout:
            orientation: "vertical"
            size_hint: 1, 1

            MDTopAppBar:
                title: "Registo de Perdas"
                md_bg_color: app.theme_tokens['primary']
                specific_text_color: app.theme_tokens['on_primary']
                elevation: 3
                left_action_items: [["arrow-left", lambda x: root.go_back(), "Voltar"]]
                right_action_items: [["format-list-bulleted", lambda x: root.open_losses_history(), "Historico"], ["barcode-scan", lambda x: root.toggle_scanner(), "Scanner"]]

            ScrollView:
                id: losses_scroll
                do_scroll_x: False
                do_scroll_y: True
                bar_width: dp(5)

                MDBoxLayout:
                    id: content_column
                    orientation: "vertical"
                    padding: [dp(14), dp(12), dp(14), dp(20)]
                    spacing: dp(12)
                    size_hint_y: None
                    height: self.minimum_height

                    MDCard:
                        id: expired_batch_banner
                        orientation: "horizontal"
                        padding: [dp(12), dp(8)]
                        spacing: dp(10)
                        elevation: 0
                        radius: [dp(10)]
                        md_bg_color: app.theme_tokens['warning']
                        size_hint_y: None
                        height: 0
                        opacity: 0
                        disabled: True

                        MDIcon:
                            icon: "alert-circle-outline"
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['on_primary']
                            size_hint: None, None
                            size: dp(22), dp(22)
                            pos_hint: {"center_y": 0.5}

                        MDLabel:
                            id: expired_batch_label
                            text: "0 produtos vencidos encontrados"
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['on_primary']
                            bold: True
                            valign: "middle"

                        MDRaisedButton:
                            text: "REGISTAR TODOS"
                            size_hint_x: None
                            width: dp(150)
                            md_bg_color: app.theme_tokens['card']
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['warning']
                            radius: [dp(8)]
                            on_release: root.open_expired_batch_modal()

                    MDCard:
                        id: search_card
                        orientation: "vertical"
                        padding: [dp(12), dp(10)]
                        spacing: dp(8)
                        elevation: 0
                        radius: [dp(12)]
                        md_bg_color: app.theme_tokens['card']
                        size_hint_y: None
                        height: dp(400) if not self.disabled else 0
                        opacity: 0 if self.disabled else 1
                        canvas.before:
                            Color:
                                rgba: app.theme_tokens.get('divider', [0.25, 0.28, 0.34, 0.5])
                            Line:
                                width: 1
                                rounded_rectangle: self.x, self.y, self.width, self.height, dp(12)

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(24)
                            spacing: dp(8)

                            MDLabel:
                                text: "Encontre o produto"
                                font_size: dp(15)
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_primary']

                            MDLabel:
                                text: "10 por pagina"
                                font_size: dp(11)
                                halign: "right"
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_secondary']

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(40)
                            spacing: dp(8)

                            MDTextField:
                                id: search_input
                                hint_text: "Nome, ID ou codigo de barras"
                                mode: "rectangle"
                                font_size: dp(13)
                                on_text: root.on_search(self.text)
                                on_text_validate: root.on_search_enter()

                            MDRaisedButton:
                                text: "PESQUISAR"
                                size_hint: None, None
                                size: dp(110), dp(34)
                                font_size: dp(12)
                                radius: [dp(8)]
                                md_bg_color: app.theme_tokens['primary']
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['on_primary']
                                pos_hint: {"center_y": 0.5}
                                on_release: root.on_search_enter()

                        # Cabecalho da tabela
                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(28)
                            padding: [dp(10), 0, dp(8), 0]
                            spacing: dp(8)
                            md_bg_color: app.theme_tokens['card_alt']
                            radius: [dp(8)]

                            MDLabel:
                                text: "Produto / codigo"
                                font_size: dp(11)
                                bold: True
                                size_hint_x: 0.48
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_secondary']

                            MDLabel:
                                text: "Preco"
                                font_size: dp(11)
                                bold: True
                                size_hint_x: 0.22
                                halign: "right"
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_secondary']

                            MDLabel:
                                text: "Estado"
                                font_size: dp(11)
                                bold: True
                                size_hint_x: 0.18
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_secondary']

                            MDLabel:
                                text: ""
                                size_hint_x: 0.12

                        ScrollView:
                            do_scroll_x: False
                            size_hint_y: 1
                            bar_width: dp(4)

                            MDBoxLayout:
                                id: products_list
                                orientation: "vertical"
                                size_hint_y: None
                                height: self.minimum_height
                                spacing: dp(4)
                                padding: [0, dp(4), 0, dp(4)]

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(36)
                            spacing: dp(8)

                            MDRaisedButton:
                                id: losses_prev_btn
                                text: "< Ant."
                                size_hint: None, None
                                size: dp(88), dp(32)
                                font_size: dp(12)
                                radius: [dp(8)]
                                elevation: 0
                                md_bg_color: app.theme_tokens['card_alt']
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_primary']
                                on_release: root.previous_products_page()

                            MDLabel:
                                id: losses_page_label
                                text: "Pag. 1"
                                halign: "center"
                                valign: "middle"
                                font_size: dp(12)
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_secondary']

                            MDRaisedButton:
                                id: losses_next_btn
                                text: "Prox. >"
                                size_hint: None, None
                                size: dp(88), dp(32)
                                font_size: dp(12)
                                radius: [dp(8)]
                                elevation: 0
                                md_bg_color: app.theme_tokens['primary']
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['on_primary']
                                on_release: root.next_products_page()

                    # Formulario (resto igual - simplified keep essential ids)

                    MDCard:
                        id: loss_form_card
                        orientation: "vertical"
                        padding: [dp(14), dp(12)]
                        spacing: dp(12)
                        elevation: 0
                        radius: [dp(12)]
                        md_bg_color: app.theme_tokens['card']
                        size_hint_y: None
                        disabled: True
                        height: self.minimum_height if not self.disabled else 0
                        opacity: 0 if self.disabled else 1

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(48)
                            spacing: dp(10)

                            MDIcon:
                                icon: "package-variant"
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['info']
                                size_hint: None, None
                                size: dp(24), dp(24)
                                pos_hint: {"center_y": 0.5}

                            MDBoxLayout:
                                orientation: "vertical"

                                MDLabel:
                                    id: selected_name
                                    text: "Produto Selecionado"
                                    font_size: dp(15)
                                    bold: True
                                    shorten: True
                                    shorten_from: "right"
                                    theme_text_color: "Custom"
                                    text_color: app.theme_tokens['text_primary']

                                MDLabel:
                                    id: selected_stock
                                    text: ""
                                    font_size: dp(12)
                                    theme_text_color: "Custom"
                                    text_color: app.theme_tokens['text_secondary']

                            MDRaisedButton:
                                text: "TROCAR"
                                size_hint: None, None
                                size: dp(90), dp(36)
                                font_size: dp(12)
                                radius: [dp(8)]
                                elevation: 0
                                md_bg_color: app.theme_tokens['card_alt']
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_primary']
                                pos_hint: {"center_y": 0.5}
                                on_release: root.clear_selection()

                        MDLabel:
                            text: "1. O que aconteceu?"
                            font_size: dp(13)
                            bold: True
                            size_hint_y: None
                            height: dp(20)
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['text_secondary']

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(44)
                            spacing: dp(8)

                            MDRaisedButton:
                                id: type_btn_DAMAGE
                                text: "DANIFICADO"
                                size_hint: 1, None
                                height: dp(44)
                                font_size: dp(12)
                                radius: [dp(10)]
                                elevation: 0
                                md_bg_color: app.theme_tokens['card_alt']
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_primary']
                                on_release: root.set_loss_type("DANIFICADO", "DAMAGE")

                            MDRaisedButton:
                                id: type_btn_EXPIRED
                                text: "EXPIRADO"
                                size_hint: 1, None
                                height: dp(44)
                                font_size: dp(12)
                                radius: [dp(10)]
                                elevation: 0
                                md_bg_color: app.theme_tokens['card_alt']
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_primary']
                                on_release: root.set_loss_type("EXPIRADO", "EXPIRED")

                            MDRaisedButton:
                                id: type_btn_THEFT
                                text: "ROUBO"
                                size_hint: 1, None
                                height: dp(44)
                                font_size: dp(12)
                                radius: [dp(10)]
                                elevation: 0
                                md_bg_color: app.theme_tokens['card_alt']
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_primary']
                                on_release: root.set_loss_type("ROUBO", "THEFT")

                            MDRaisedButton:
                                id: type_btn_ADJUSTMENT
                                text: "AJUSTE"
                                size_hint: 1, None
                                height: dp(44)
                                font_size: dp(12)
                                radius: [dp(10)]
                                elevation: 0
                                md_bg_color: app.theme_tokens['card_alt']
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_primary']
                                on_release: root.set_loss_type("AJUSTE", "ADJUSTMENT")

                        MDLabel:
                            text: "2. Motivo"
                            font_size: dp(13)
                            bold: True
                            size_hint_y: None
                            height: dp(20)
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['text_secondary']

                        MDBoxLayout:
                            id: reason_box
                            orientation: "vertical"
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: dp(6)

                        MDLabel:
                            text: "3. Quantidade"
                            font_size: dp(13)
                            bold: True
                            size_hint_y: None
                            height: dp(20)
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['text_secondary']

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(48)
                            spacing: dp(8)

                            MDRaisedButton:
                                text: "-"
                                size_hint: None, None
                                size: dp(48), dp(48)
                                font_size: dp(20)
                                radius: [dp(10)]
                                elevation: 0
                                md_bg_color: app.theme_tokens['card_alt']
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_primary']
                                on_release: root.change_qty(-1)

                            MDTextField:
                                id: qty_input
                                hint_text: "Qtd"
                                input_filter: "float"
                                mode: "rectangle"
                                font_size: dp(15)
                                size_hint: None, None
                                size: dp(110), dp(48)
                                on_text: root.on_qty_change(self.text)

                            MDRaisedButton:
                                text: "+"
                                size_hint: None, None
                                size: dp(48), dp(48)
                                font_size: dp(20)
                                radius: [dp(10)]
                                elevation: 0
                                md_bg_color: app.theme_tokens['card_alt']
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_primary']
                                on_release: root.change_qty(1)

                            MDLabel:
                                id: qty_hint
                                text: ""
                                font_size: dp(12)
                                valign: "middle"
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_secondary']

                        MDBoxLayout:
                            id: damage_evidence_card
                            size_hint_y: None
                            disabled: True
                            height: dp(72) if not self.disabled else 0
                            opacity: 0 if self.disabled else 1
                            spacing: dp(10)

                            Image:
                                id: damage_evidence_preview
                                source: ""
                                opacity: 0
                                allow_stretch: True
                                keep_ratio: True
                                size_hint: None, None
                                size: dp(64), dp(64)
                                pos_hint: {"center_y": 0.5}

                            MDBoxLayout:
                                orientation: "vertical"

                                MDLabel:
                                    id: damage_evidence_status
                                    text: ""
                                    font_size: dp(12)
                                    text_size: self.width, None
                                    valign: "middle"
                                    theme_text_color: "Custom"
                                    text_color: app.theme_tokens['text_primary']

                                MDLabel:
                                    id: damage_evidence_file
                                    text: ""
                                    font_size: dp(11)
                                    size_hint_y: None
                                    height: dp(16)
                                    theme_text_color: "Custom"
                                    text_color: app.theme_tokens['text_secondary']

                            MDRaisedButton:
                                text: "TIRAR FOTO"
                                size_hint: None, None
                                size: dp(130), dp(44)
                                font_size: dp(12)
                                radius: [dp(10)]
                                elevation: 0
                                md_bg_color: app.theme_tokens['primary']
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['on_primary']
                                pos_hint: {"center_y": 0.5}
                                on_release: root.open_damage_camera()

                        MDTextField:
                            id: note_input
                            hint_text: "Observacao (opcional)"
                            mode: "rectangle"
                            font_size: dp(14)
                            size_hint_y: None
                            height: dp(48)



            MDCard:
                id: loss_action_bar
                orientation: "horizontal"
                padding: [dp(14), dp(8)]
                spacing: dp(12)
                elevation: 3
                radius: [0, 0, 0, 0]
                md_bg_color: app.theme_tokens['card']
                size_hint_y: None
                disabled: True
                height: dp(72) if not self.disabled else 0
                opacity: 0 if self.disabled else 1

                MDBoxLayout:
                    orientation: "vertical"

                    MDLabel:
                        id: loss_missing_hint
                        text: ""
                        font_size: dp(12)
                        bold: True
                        theme_text_color: "Custom"
                        text_color: app.theme_tokens['warning']

                    MDLabel:
                        id: loss_impact_label
                        text: "Custo 0.00 MZN  ·  Receita perdida 0.00 MZN"
                        font_size: dp(12)
                        theme_text_color: "Custom"
                        text_color: app.theme_tokens['text_secondary']

                MDRaisedButton:
                    id: submit_loss_btn
                    text: "REGISTRAR PERDA"
                    size_hint: None, None
                    size: dp(220), dp(48)
                    font_size: dp(13)
                    radius: [dp(10)]
                    elevation: 0
                    md_bg_color: app.theme_tokens['danger']
                    theme_text_color: "Custom"
                    text_color: app.theme_tokens['on_primary']
                    pos_hint: {"center_y": 0.5}
                    on_release: root.submit_loss()


        LossesFloatingScannerPanel:
            id: scanner_preview_card
            orientation: "vertical"
            size_hint: None, None
            size: dp(280), dp(240)
            pos: root.width - self.width - dp(16), dp(16)
            md_bg_color: app.theme_tokens['card_alt']
            radius: [dp(14)]
            elevation: 5
            padding: dp(10)
            spacing: dp(8)
            opacity: 0
            disabled: True

            MDBoxLayout:
                size_hint_y: None
                height: dp(28)
                spacing: dp(6)

                MDLabel:
                    text: "Scanner"
                    bold: True
                    font_size: dp(13)
                    theme_text_color: "Custom"
                    text_color: app.theme_tokens['text_primary']

                MDLabel:
                    text: "arraste"
                    halign: "right"
                    font_size: dp(10)
                    theme_text_color: "Custom"
                    text_color: app.theme_tokens['text_secondary']

            MDCard:
                size_hint_y: 1
                radius: [dp(10)]
                elevation: 0
                md_bg_color: app.theme_tokens['card']
                padding: dp(4)

                Image:
                    id: camera_image
                    allow_stretch: True
                    keep_ratio: True

            MDLabel:
                id: scanner_status
                text: "Pronto"
                halign: "center"
                font_size: dp(11)
                size_hint_y: None
                height: dp(16)
                theme_text_color: "Custom"
                text_color: app.theme_tokens['text_secondary']

            MDBoxLayout:
                id: scanner_buttons_row
                size_hint_y: None
                height: dp(40)
                spacing: dp(8)
                size_hint_x: None
                width: dp(128)
                pos_hint: {"center_x": 0.5}

                TooltipIconButton:
                    id: scan_btn
                    icon: "barcode-scan"
                    md_bg_color: app.theme_tokens['success']
                    theme_text_color: "Custom"
                    text_color: app.theme_tokens['on_primary']
                    size_hint: None, None
                    size: dp(36), dp(36)
                    hint_text: "Iniciar ou parar scanner"
                    on_release: root.toggle_scanner()

                TooltipIconButton:
                    icon: "camera-switch"
                    md_bg_color: app.theme_tokens['info']
                    theme_text_color: "Custom"
                    text_color: app.theme_tokens['on_primary']
                    size_hint: None, None
                    size: dp(36), dp(36)
                    hint_text: "Trocar camera"
                    on_release: root.switch_camera()

                MDRaisedButton:
                    text: "X"
                    size_hint: None, None
                    size: dp(36), dp(36)
                    font_size: dp(14)
                    bold: True
                    radius: [dp(8)]
                    elevation: 0
                    md_bg_color: app.theme_tokens['danger']
                    theme_text_color: "Custom"
                    text_color: app.theme_tokens['on_primary']
                    on_release: root.close_scanner_panel()

        LossesFloatingScannerPanel:
            id: damage_camera_preview_card
            orientation: "vertical"
            size_hint: None, None
            size: dp(340), dp(380)
            pos: root.width - self.width - dp(16), dp(16)
            md_bg_color: app.theme_tokens['card_alt']
            radius: [dp(14)]
            elevation: 5
            padding: [dp(12), dp(10), dp(12), dp(20)]
            spacing: dp(8)
            opacity: 0
            disabled: True

            MDBoxLayout:
                size_hint_y: None
                height: dp(30)
                spacing: dp(8)

                MDLabel:
                    text: "Camera de evidencia"
                    bold: True
                    font_size: dp(13)
                    theme_text_color: "Custom"
                    text_color: app.theme_tokens['text_primary']

                MDRaisedButton:
                    text: "X"
                    size_hint: None, None
                    size: dp(36), dp(28)
                    font_size: dp(13)
                    bold: True
                    radius: [dp(8)]
                    elevation: 0
                    md_bg_color: app.theme_tokens['danger']
                    theme_text_color: "Custom"
                    text_color: app.theme_tokens['on_primary']
                    on_release: root.close_damage_camera_panel()

            MDCard:
                size_hint_y: 1
                radius: [dp(10)]
                elevation: 0
                md_bg_color: app.theme_tokens['card']
                padding: dp(4)

                Image:
                    id: damage_camera_image
                    allow_stretch: True
                    keep_ratio: True

            MDLabel:
                id: damage_camera_status
                text: "A preparar a camera..."
                halign: "center"
                font_size: dp(11)
                size_hint_y: None
                height: dp(28)
                theme_text_color: "Custom"
                text_color: app.theme_tokens['text_secondary']

            MDBoxLayout:
                size_hint_y: None
                height: dp(40)
                spacing: dp(8)

                MDRaisedButton:
                    id: damage_camera_capture_btn
                    text: "CAPTURAR"
                    radius: [dp(10)]
                    md_bg_color: app.theme_tokens['primary']
                    theme_text_color: "Custom"
                    text_color: app.theme_tokens['on_primary']
                    on_release: root.capture_damage_camera_frame()

                MDRaisedButton:
                    id: damage_camera_use_btn
                    text: "UTILIZAR FOTO"
                    radius: [dp(10)]
                    md_bg_color: app.theme_tokens['success']
                    theme_text_color: "Custom"
                    text_color: app.theme_tokens['on_primary']
                    disabled: True
                    on_release: root.use_damage_camera_snapshot()

            MDBoxLayout:
                size_hint_y: None
                height: dp(32)
                spacing: dp(8)

                MDFlatButton:
                    id: damage_camera_retake_btn
                    text: "REPETIR"
                    disabled: True
                    on_release: root.retake_damage_camera_photo()

                MDFlatButton:
                    text: "TROCAR CAMERA"
                    on_release: root.switch_damage_camera()
