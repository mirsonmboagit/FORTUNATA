#:kivy 2.0

<SettingsCenteredIcon@MDIcon>:
    halign: 'center'
    valign: 'middle'
    text_size: self.size

<SettingsIconBadge@MDCard>:
    icon_name: 'cog'
    accent_color: app.theme_tokens['primary']
    icon_color: app.theme_tokens['on_primary']
    icon_size: dp(18)
    size_hint: None, None
    size: dp(36), dp(36)
    radius: [dp(12)]
    elevation: 0
    md_bg_color: root.accent_color

    AnchorLayout:
        anchor_x: 'center'
        anchor_y: 'center'

        SettingsCenteredIcon:
            icon: root.icon_name
            size_hint: None, None
            size: root.icon_size, root.icon_size
            font_size: root.icon_size
            theme_text_color: 'Custom'
            text_color: root.icon_color

<SettingsInlineIconSlot@AnchorLayout>:
    icon_name: 'flash'
    icon_color: app.theme_tokens['on_primary']
    icon_size: dp(16)
    box_size: dp(18)
    size_hint: None, None
    size: root.box_size, root.box_size
    anchor_x: 'center'
    anchor_y: 'center'

    SettingsCenteredIcon:
        icon: root.icon_name
        size_hint: None, None
        size: root.icon_size, root.icon_size
        font_size: root.icon_size
        theme_text_color: 'Custom'
        text_color: root.icon_color

<SettingsPanelCard@HoverCard>:
    radius: [dp(16)]
    elevation: 1
    line_color: app.theme_tokens['divider']
    line_width: 1
    hover_bg_mix: 0.05
    hover_line_mix: 0.22
    hover_elevation_delta: 1.4
    hover_duration: 0.12
    hover_accent_color: app.theme_tokens['primary']

<SettingsPreferenceCard@HoverCard>:
    radius: [dp(12)]
    elevation: 0
    line_color: app.theme_tokens['divider']
    line_width: 1
    hover_bg_mix: 0.08
    hover_line_mix: 0.2
    hover_elevation_delta: 1.0
    hover_duration: 0.12
    hover_accent_color: app.theme_tokens['primary']

<SettingsActionCard@HoverButtonCard>:
    icon_name: 'cog'
    title_text: ''
    subtitle_text: ''
    accent_color: app.theme_tokens['primary']
    tone_color: app.theme_tokens['card_alt']
    size_hint_y: None
    height: dp(88)
    padding: [dp(12), dp(10), dp(12), dp(10)]
    radius: [dp(14)]
    elevation: 0
    md_bg_color: root.tone_color
    ripple_behavior: True
    line_color: app.theme_tokens['divider']
    line_width: 1
    press_enabled: True
    hover_bg_mix: 0.10
    hover_line_mix: 0.24
    hover_elevation_delta: 1.8
    hover_duration: 0.12
    hover_accent_color: root.accent_color

    MDBoxLayout:
        orientation: 'vertical'
        spacing: dp(6)

        MDBoxLayout:
            size_hint_y: None
            height: dp(34)
            spacing: dp(8)

            SettingsIconBadge:
                icon_name: root.icon_name
                accent_color: root.accent_color
                icon_color: app.theme_tokens['on_primary']
                icon_size: dp(16)
                size: dp(32), dp(32)

            Widget:

            SettingsInlineIconSlot:
                icon_name: 'chevron-right'
                icon_color: app.theme_tokens['text_muted']
                icon_size: dp(16)
                box_size: dp(16)

        MDLabel:
            text: root.title_text
            font_style: 'Subtitle2'
            bold: True
            size_hint_y: None
            height: dp(18)
            theme_text_color: 'Custom'
            text_color: app.theme_tokens['text_primary']
            shorten: True
            shorten_from: 'right'

        MDLabel:
            text: root.subtitle_text
            font_style: 'Caption'
            size_hint_y: None
            height: dp(16)
            theme_text_color: 'Custom'
            text_color: app.theme_tokens['text_secondary']
            shorten: True
            shorten_from: 'right'

<AdminSettingsScreen>:
    md_bg_color: app.theme_tokens['surface']

    FloatLayout:
        MDBoxLayout:
            orientation: 'vertical'
            size_hint: 1, 1
            md_bg_color: app.theme_tokens['surface']

            MDTopAppBar:
                title: app.t('settings.title', app.language)
                md_bg_color: app.theme_tokens['primary']
                specific_text_color: app.theme_tokens['on_primary']
                left_action_items: [['arrow-left', lambda x: root.go_back()]]
                right_action_items: [['history', lambda x: root.open_ai_menu()]]
                elevation: 2

            ScrollView:
                id: settings_scroll
                do_scroll_x: False
                do_scroll_y: True
                bar_width: dp(5)
                size_hint: 1, 1

                MDBoxLayout:
                    id: settings_content
                    orientation: 'vertical'
                    spacing: dp(12)
                    padding: [dp(14), dp(12), dp(14), dp(88)]
                    size_hint_y: None
                    height: self.minimum_height

                    SettingsPanelCard:
                        id: settings_hero
                        size_hint_y: None
                        height: dp(88)
                        padding: [dp(14), dp(12), dp(14), dp(12)]
                        spacing: dp(4)
                        radius: [dp(16)]
                        md_bg_color: app.theme_tokens['card']
                        hover_accent_color: app.theme_tokens['primary']

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(32)
                            spacing: dp(8)

                            SettingsIconBadge:
                                icon_name: 'tune'
                                accent_color: app.theme_tokens['primary']
                                icon_size: dp(16)
                                size: dp(32), dp(32)

                            MDLabel:
                                text: 'Definicoes'
                                font_style: 'Subtitle1'
                                bold: True
                                valign: 'middle'
                                theme_text_color: 'Custom'
                                text_color: app.theme_tokens['text_primary']

                        MDLabel:
                            text: 'Escolha uma categoria para abrir as opcoes necessarias.'
                            font_style: 'Caption'
                            size_hint_y: None
                            height: dp(16)
                            theme_text_color: 'Custom'
                            text_color: app.theme_tokens['text_secondary']
                            shorten: True
                            shorten_from: 'right'

                        MDLabel:
                            text: root.system_name + '  ·  ' + root.language_label
                            font_style: 'Caption'
                            size_hint_y: None
                            height: dp(14)
                            theme_text_color: 'Custom'
                            text_color: app.theme_tokens['text_muted']

                    MDLabel:
                        text: 'Categorias'
                        font_style: 'Subtitle2'
                        bold: True
                        size_hint_y: None
                        height: dp(20)
                        theme_text_color: 'Custom'
                        text_color: app.theme_tokens['text_primary']

                    MDGridLayout:
                        id: settings_menu_grid
                        cols: 2
                        spacing: [dp(10), dp(10)]
                        size_hint_y: None
                        height: self.minimum_height
                        row_default_height: dp(88)
                        row_force_default: False

                        SettingsActionCard:
                            icon_name: 'flash'
                            title_text: 'Preferencias rapidas'
                            subtitle_text: 'Tema, avisos, apoio externo e idioma.'
                            accent_color: app.theme_tokens['primary']
                            on_release: root.open_quick_preferences()

                        SettingsActionCard:
                            icon_name: 'printer-pos'
                            title_text: 'Dispositivos POS'
                            subtitle_text: 'Leitor fisico, impressao e impressora.'
                            accent_color: app.theme_tokens['info']
                            on_release: root.open_pos_settings()

                        SettingsActionCard:
                            icon_name: 'receipt-text-outline'
                            title_text: 'Fiscal e IVA'
                            subtitle_text: root.vat_overview_text
                            accent_color: app.theme_tokens['warning']
                            on_release: root.open_fiscal_settings()

                        SettingsActionCard:
                            icon_name: 'desktop-classic'
                            title_text: 'Sistema'
                            subtitle_text: 'Nome, idioma, logs, estado e janela.'
                            accent_color: app.theme_tokens['success']
                            on_release: root.open_system_settings()

                        SettingsActionCard:
                            icon_name: 'shield-account'
                            title_text: 'Acesso e seguranca'
                            subtitle_text: 'Utilizadores, recuperacao e credenciais.'
                            accent_color: app.theme_tokens['danger']
                            on_release: root.open_security_settings()

                        SettingsActionCard:
                            icon_name: 'cloud-sync-outline'
                            title_text: 'Integracoes e cache'
                            subtitle_text: 'Apoio externo, caches e barcodes.'
                            accent_color: app.theme_tokens['primary']
                            on_release: root.open_integrations_settings()

                    SettingsPreferenceCard:
                        size_hint_y: None
                        height: dp(40)
                        padding: [dp(10), dp(8), dp(10), dp(8)]
                        radius: [dp(10)]
                        md_bg_color: app.theme_tokens['card_alt']
                        hover_accent_color: app.theme_tokens['info']

                        MDBoxLayout:
                            spacing: dp(8)

                            SettingsInlineIconSlot:
                                icon_name: 'information-outline'
                                icon_color: app.theme_tokens['text_muted']
                                icon_size: dp(16)
                                box_size: dp(16)

                            MDLabel:
                                text: 'As opcoes abrem em janelas proprias para manter esta tela organizada.'
                                font_style: 'Caption'
                                theme_text_color: 'Custom'
                                text_color: app.theme_tokens['text_secondary']
                                valign: 'middle'
                                shorten: True
                                shorten_from: 'right'

        MDBoxLayout:
            id: settings_fab_stack
            orientation: 'vertical'
            spacing: dp(10)
            size_hint: None, None
            size: dp(56), dp(122)
            pos_hint: {'right': 0.97, 'y': 0.03}

            FloatLayout:
                size_hint_y: None
                height: dp(56)

                MDFloatingActionButton:
                    id: recommendations_button
                    icon: 'lightbulb-outline'
                    icon_size: dp(26)
                    elevation: 2
                    md_bg_color: app.theme_tokens['card_alt']
                    size_hint: None, None
                    size: dp(52), dp(52)
                    pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                    on_release: root.show_ai_recommendations(self)

                MDCard:
                    id: recommendations_badge
                    size_hint: None, None
                    size: dp(22), dp(22)
                    md_bg_color: app.theme_tokens['badge']
                    radius: [dp(11)]
                    elevation: 3
                    pos_hint: {'right': 0.95, 'top': 0.98}
                    opacity: 1

                    MDLabel:
                        id: recommendations_badge_label
                        text: '0'
                        halign: 'center'
                        valign: 'middle'
                        theme_text_color: 'Custom'
                        text_color: app.theme_tokens['on_primary']
                        font_size: dp(10)
                        bold: True

            FloatLayout:
                size_hint_y: None
                height: dp(56)

                MDFloatingActionButton:
                    id: ai_button
                    icon: 'bell-ring-outline'
                    icon_size: dp(26)
                    elevation: 2
                    md_bg_color: app.theme_tokens['primary']
                    size_hint: None, None
                    size: dp(52), dp(52)
                    pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                    on_release: root.open_ai_menu(self)

                MDCard:
                    id: ai_badge
                    size_hint: None, None
                    size: dp(22), dp(22)
                    md_bg_color: app.theme_tokens['badge']
                    radius: [dp(11)]
                    elevation: 3
                    pos_hint: {'right': 0.95, 'top': 0.98}
                    opacity: 1

                    MDLabel:
                        id: ai_badge_label
                        text: '0'
                        halign: 'center'
                        valign: 'middle'
                        theme_text_color: 'Custom'
                        text_color: app.theme_tokens['on_primary']
                        font_size: dp(10)
                        bold: True

        FloatLayout:
            id: ai_banner_container
            size_hint: 1, 1
            pos: 0, 0
