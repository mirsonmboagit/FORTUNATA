#:kivy 2.0

<ReportsPanelCard@HoverCard>:
    elevation: 1
    radius: [dp(14)]
    line_color: app.theme_tokens['divider']
    line_width: 1
    hover_bg_mix: 0.05
    hover_line_mix: 0.22
    hover_elevation_delta: 1.4
    hover_duration: 0.12
    hover_accent_color: app.theme_tokens['primary']

<ReportsGhostButton@HoverRaisedButton>:
    size_hint_y: None
    height: dp(42)
    elevation: 0
    radius: [dp(12)]
    line_color: app.theme_tokens['divider']
    line_width: 1
    press_enabled: True
    hover_bg_mix: 0.12
    hover_line_mix: 0.22
    hover_elevation_delta: 1.4
    hover_duration: 0.12

<ReportsAccentButton@HoverRaisedButton>:
    size_hint_y: None
    height: dp(42)
    radius: [dp(12)]
    line_width: 1
    press_enabled: True
    hover_bg_mix: 0.10
    hover_line_mix: 0.20
    hover_elevation_delta: 2.0
    hover_duration: 0.12

<ReportsRangeButton@HoverRaisedButton>:
    size_hint_y: None
    height: dp(40)
    elevation: 0
    radius: [dp(10)]
    line_color: app.theme_tokens['divider']
    line_width: 1
    press_enabled: True
    hover_bg_mix: 0.12
    hover_line_mix: 0.20
    hover_elevation_delta: 1.4
    hover_duration: 0.12
    font_size: sp(12)

<ReportsReportButton@HoverRaisedButton>:
    size_hint_y: None
    height: dp(48)
    radius: [dp(12)]
    font_size: sp(13)
    elevation: 1
    press_enabled: True
    hover_bg_mix: 0.12
    hover_line_mix: 0.22
    hover_elevation_delta: 2.2
    hover_duration: 0.12
    line_width: 1

<ReportsScreen>:
    name: 'reports'
    date_label: date_label
    product_spinner: product_spinner
    category_spinner: category_spinner
    seller_spinner: seller_spinner
    md_bg_color: app.theme_tokens['surface']

    FloatLayout:
        MDBoxLayout:
            orientation: 'vertical'
            size_hint: 1, 1
            md_bg_color: app.theme_tokens['surface']

            MDTopAppBar:
                title: 'Relatorios'
                md_bg_color: app.theme_tokens['primary']
                specific_text_color: app.theme_tokens['on_primary']
                elevation: 3
                left_action_items: [["arrow-left", lambda x: root.go_back(), "Voltar"]]
                right_action_items: [["file-pdf-box", lambda x: root.show_pdf_viewer(), "Todos os PDFs"], ["refresh", lambda x: root.refresh_screen_data(), "Atualizar"]]

            ScrollView:
                do_scroll_x: False
                do_scroll_y: True
                bar_width: dp(5)

                MDBoxLayout:
                    id: reports_content
                    orientation: 'vertical'
                    spacing: dp(14)
                    padding: [dp(16), dp(14), dp(16), dp(88)]
                    size_hint_y: None
                    height: self.minimum_height

                    # Filtros
                    ReportsPanelCard:
                        id: filters_card
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(0)
                        padding: [dp(16), dp(14), dp(16), dp(16)]
                        md_bg_color: app.theme_tokens['card']
                        radius: [dp(14)]
                        hover_accent_color: app.theme_tokens['info']

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(28)
                            spacing: dp(8)

                            MDIcon:
                                icon: 'filter-variant'
                                theme_text_color: 'Custom'
                                text_color: app.theme_tokens['primary']
                                size_hint: None, None
                                size: dp(22), dp(22)
                                pos_hint: {'center_y': 0.5}

                            MDLabel:
                                text: 'Configurar filtros'
                                font_style: 'H6'
                                bold: True
                                theme_text_color: 'Custom'
                                text_color: app.theme_tokens['text_primary']
                                valign: 'middle'

                        Widget:
                            size_hint_y: None
                            height: dp(8)

                        MDBoxLayout:
                            id: search_row
                            orientation: 'horizontal'
                            size_hint_y: None
                            height: dp(48)
                            spacing: dp(8)

                            MDTextField:
                                id: report_search_input
                                hint_text: 'Pesquisar relatorio, produto ou categoria'
                                mode: 'rectangle'
                                icon_left: 'magnify'
                                on_text: root.on_search(self.text)
                                on_text_validate: root.on_search_enter()

                            ReportsGhostButton:
                                id: search_clear_button
                                text: 'Limpar'
                                size_hint_x: None
                                width: dp(100)
                                md_bg_color: app.theme_tokens['card_alt']
                                text_color: app.theme_tokens['text_primary']
                                hover_accent_color: app.theme_tokens['primary']
                                on_release: root.clear_search()

                        MDLabel:
                            text: root.search_status_text
                            font_style: 'Caption'
                            theme_text_color: 'Custom'
                            text_color: app.theme_tokens['text_secondary']
                            text_size: self.width, None
                            size_hint_y: None
                            height: max(dp(18), self.texture_size[1])

                        Widget:
                            size_hint_y: None
                            height: dp(10)

                        # Periodo
                        MDBoxLayout:
                            id: period_row
                            orientation: 'horizontal'
                            size_hint_y: None
                            height: dp(48)
                            spacing: dp(12)

                            MDBoxLayout:
                                orientation: 'vertical'
                                spacing: dp(2)

                                MDLabel:
                                    text: 'Periodo'
                                    font_style: 'Caption'
                                    bold: True
                                    theme_text_color: 'Custom'
                                    text_color: app.theme_tokens['text_secondary']
                                    size_hint_y: None
                                    height: dp(18)

                                MDLabel:
                                    id: date_label
                                    text: 'Nenhum periodo selecionado'
                                    font_style: 'Body2'
                                    theme_text_color: 'Custom'
                                    text_color: app.theme_tokens['text_primary']
                                    size_hint_y: None
                                    height: dp(22)
                                    shorten: True

                            ReportsAccentButton:
                                text: 'Selecionar periodo'
                                size_hint_x: None
                                width: dp(170)
                                md_bg_color: app.theme_tokens['warning']
                                text_color: app.theme_tokens['on_primary']
                                hover_accent_color: [1, 1, 1, 1]
                                on_release: root.select_date_range()

                        Widget:
                            size_hint_y: None
                            height: dp(8)

                        MDGridLayout:
                            id: quick_range_grid
                            cols: 5
                            spacing: dp(8)
                            size_hint_y: None
                            height: dp(40)

                            ReportsRangeButton:
                                text: 'Hoje'
                                md_bg_color: app.theme_tokens['card_alt']
                                text_color: app.theme_tokens['warning']
                                hover_accent_color: app.theme_tokens['warning']
                                on_release: root.apply_today_range()

                            ReportsRangeButton:
                                text: '7 dias'
                                md_bg_color: app.theme_tokens['card_alt']
                                text_color: app.theme_tokens['primary']
                                hover_accent_color: app.theme_tokens['primary']
                                on_release: root.apply_last_days_range(7)

                            ReportsRangeButton:
                                text: '30 dias'
                                md_bg_color: app.theme_tokens['card_alt']
                                text_color: app.theme_tokens['success']
                                hover_accent_color: app.theme_tokens['success']
                                on_release: root.apply_last_days_range(30)

                            ReportsRangeButton:
                                text: 'Este mes'
                                md_bg_color: app.theme_tokens['card_alt']
                                text_color: app.theme_tokens['info']
                                hover_accent_color: app.theme_tokens['info']
                                on_release: root.apply_current_month_range()

                            ReportsRangeButton:
                                text: 'Este ano'
                                md_bg_color: app.theme_tokens['card_alt']
                                text_color: app.theme_tokens['primary']
                                hover_accent_color: app.theme_tokens['primary']
                                on_release: root.apply_current_year_range()

                        Widget:
                            size_hint_y: None
                            height: dp(12)

                        MDGridLayout:
                            id: filters_grid
                            cols: 2
                            spacing: [dp(10), dp(10)]
                            size_hint_y: None
                            height: dp(64)

                            MDBoxLayout:
                                orientation: 'vertical'
                                spacing: dp(2)

                                MDLabel:
                                    text: 'Produto'
                                    font_style: 'Caption'
                                    bold: True
                                    theme_text_color: 'Custom'
                                    text_color: app.theme_tokens['text_secondary']
                                    size_hint_y: None
                                    height: dp(18)

                                ReportsGhostButton:
                                    id: product_spinner
                                    text: 'Todos os Produtos'
                                    md_bg_color: app.theme_tokens['card_alt']
                                    text_color: app.theme_tokens['text_primary']
                                    shorten: True
                                    hover_accent_color: app.theme_tokens['primary']
                                    on_release: root.open_product_menu(self)

                            MDBoxLayout:
                                orientation: 'vertical'
                                spacing: dp(2)

                                MDLabel:
                                    text: 'Categoria'
                                    font_style: 'Caption'
                                    bold: True
                                    theme_text_color: 'Custom'
                                    text_color: app.theme_tokens['text_secondary']
                                    size_hint_y: None
                                    height: dp(18)

                                ReportsGhostButton:
                                    id: category_spinner
                                    text: 'Todas as Categorias'
                                    md_bg_color: app.theme_tokens['card_alt']
                                    text_color: app.theme_tokens['text_primary']
                                    shorten: True
                                    hover_accent_color: app.theme_tokens['info']
                                    on_release: root.open_category_menu(self)

                        Widget:
                            size_hint_y: None
                            height: dp(8)

                        MDBoxLayout:
                            id: seller_filter_row
                            orientation: 'horizontal'
                            size_hint_y: None
                            height: dp(48)
                            spacing: dp(12)

                            MDBoxLayout:
                                orientation: 'vertical'
                                spacing: dp(2)

                                MDLabel:
                                    text: 'Vendedor / Gerente'
                                    font_style: 'Caption'
                                    bold: True
                                    theme_text_color: 'Custom'
                                    text_color: app.theme_tokens['text_secondary']
                                    size_hint_y: None
                                    height: dp(18)

                                ReportsGhostButton:
                                    id: seller_spinner
                                    text: 'Todos os Vendedores'
                                    md_bg_color: app.theme_tokens['card_alt']
                                    text_color: app.theme_tokens['text_primary']
                                    shorten: True
                                    hover_accent_color: app.theme_tokens['warning']
                                    on_release: root.open_seller_menu(self)

                        Widget:
                            size_hint_y: None
                            height: dp(10)

                        MDBoxLayout:
                            id: filter_actions
                            orientation: 'horizontal'
                            size_hint_y: None
                            height: dp(42)
                            spacing: dp(10)

                            ReportsGhostButton:
                                id: filter_reset_button
                                text: 'Limpar filtros'
                                size_hint_x: 0.5
                                md_bg_color: app.theme_tokens['card_alt']
                                text_color: app.theme_tokens['text_primary']
                                hover_accent_color: app.theme_tokens['warning']
                                on_release: root.reset_filters()

                            ReportsAccentButton:
                                id: filter_refresh_button
                                text: 'Atualizar dados'
                                size_hint_x: 0.5
                                md_bg_color: app.theme_tokens['info']
                                text_color: app.theme_tokens['on_primary']
                                hover_accent_color: [1, 1, 1, 1]
                                on_release: root.refresh_screen_data()

                    # Gerar relatorios
                    ReportsPanelCard:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        padding: [dp(16), dp(14), dp(16), dp(16)]
                        spacing: dp(8)
                        md_bg_color: app.theme_tokens['card']
                        radius: [dp(14)]
                        hover_accent_color: app.theme_tokens['primary']

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(28)
                            spacing: dp(8)

                            MDIcon:
                                icon: 'file-chart-outline'
                                theme_text_color: 'Custom'
                                text_color: app.theme_tokens['primary']
                                size_hint: None, None
                                size: dp(22), dp(22)
                                pos_hint: {'center_y': 0.5}

                            MDLabel:
                                text: 'Gerar relatorio'
                                font_style: 'H6'
                                bold: True
                                theme_text_color: 'Custom'
                                text_color: app.theme_tokens['text_primary']
                                valign: 'middle'

                        MDLabel:
                            text: root.search_summary_text
                            font_style: 'Caption'
                            theme_text_color: 'Custom'
                            text_color: app.theme_tokens['text_secondary']
                            size_hint_y: None
                            height: dp(20)

                        MDGridLayout:
                            id: reports_grid
                            cols: 2
                            spacing: [dp(10), dp(10)]
                            size_hint_y: None
                            height: self.minimum_height

                            ReportsReportButton:
                                id: sales_report_card
                                text: 'Vendas'
                                md_bg_color: app.theme_tokens['primary']
                                text_color: app.theme_tokens['on_primary']
                                hover_accent_color: [1, 1, 1, 1]
                                on_release: root.generate_sales_report()

                            ReportsReportButton:
                                id: stock_report_card
                                text: 'Estoque'
                                md_bg_color: app.theme_tokens['success']
                                text_color: app.theme_tokens['on_primary']
                                hover_accent_color: [1, 1, 1, 1]
                                on_release: root.generate_stock_report()

                            ReportsReportButton:
                                id: profit_report_card
                                text: 'Lucro'
                                md_bg_color: app.theme_tokens['warning']
                                text_color: app.theme_tokens['on_primary']
                                hover_accent_color: [1, 1, 1, 1]
                                on_release: root.generate_profit_report()

                            ReportsReportButton:
                                id: complete_report_card
                                text: 'Completo'
                                md_bg_color: app.theme_tokens['info']
                                text_color: app.theme_tokens['on_primary']
                                hover_accent_color: [1, 1, 1, 1]
                                on_release: root.generate_complete_report()

                            ReportsReportButton:
                                id: cash_user_report_card
                                text: 'Caixa por utilizador'
                                md_bg_color: app.theme_tokens['badge']
                                text_color: app.theme_tokens['on_primary']
                                hover_accent_color: [1, 1, 1, 1]
                                on_release: root.generate_cash_user_report()

                        ReportsPanelCard:
                            id: reports_empty_state
                            size_hint_y: None
                            height: 0
                            opacity: 0
                            disabled: True
                            padding: [dp(14), dp(14)]
                            md_bg_color: app.theme_tokens['card_alt']
                            radius: [dp(10)]
                            hover_enabled: False

                            MDLabel:
                                text: 'Nenhum relatorio combina com a pesquisa atual.'
                                halign: 'center'
                                theme_text_color: 'Custom'
                                text_color: app.theme_tokens['text_primary']

                    # Graficos
                    MDBoxLayout:
                        size_hint_y: None
                        height: dp(42)
                        spacing: dp(10)

                        ReportsAccentButton:
                            id: print_charts_button
                            text: 'Imprimir graficos'
                            md_bg_color: app.theme_tokens['success']
                            text_color: app.theme_tokens['on_primary']
                            hover_accent_color: [1, 1, 1, 1]
                            size_hint_x: None
                            width: dp(180)
                            on_release: root.print_productivity_charts()

                        Widget:

                    MDBoxLayout:
                        id: productivity_dashboard_host
                        orientation: 'vertical'
                        spacing: 0
                        size_hint_y: None
                        height: self.minimum_height

        # FABs empilhados
        MDBoxLayout:
            id: reports_fab_stack
            orientation: 'vertical'
            spacing: dp(10)
            size_hint: None, None
            size: dp(56), dp(122)
            pos_hint: {'right': 0.97, 'y': 0.03}

            FloatLayout:
                size_hint_y: None
                height: dp(56)

                MDFloatingActionButton:
                    id: recommendations_button
                    icon: 'lightbulb-outline'
                    icon_size: dp(24)
                    elevation: 2
                    md_bg_color: app.theme_tokens['card_alt']
                    size_hint: None, None
                    size: dp(52), dp(52)
                    pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                    on_release: root.show_ai_recommendations(self)

                MDCard:
                    id: recommendations_badge
                    size_hint: None, None
                    size: dp(22), dp(22)
                    md_bg_color: app.theme_tokens['badge']
                    radius: [dp(11)]
                    elevation: 3
                    pos_hint: {'right': 0.95, 'top': 0.98}

                    MDLabel:
                        id: recommendations_badge_label
                        text: '0'
                        halign: 'center'
                        valign: 'middle'
                        theme_text_color: 'Custom'
                        text_color: app.theme_tokens['on_primary']
                        font_size: dp(10)
                        bold: True

            FloatLayout:
                size_hint_y: None
                height: dp(56)

                MDFloatingActionButton:
                    id: ai_button
                    icon: 'bell-ring-outline'
                    icon_size: dp(24)
                    elevation: 2
                    md_bg_color: app.theme_tokens['primary']
                    size_hint: None, None
                    size: dp(52), dp(52)
                    pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                    on_release: root.open_ai_menu(self)

                MDCard:
                    id: ai_badge
                    size_hint: None, None
                    size: dp(22), dp(22)
                    md_bg_color: app.theme_tokens['badge']
                    radius: [dp(11)]
                    elevation: 3
                    pos_hint: {'right': 0.95, 'top': 0.98}

                    MDLabel:
                        id: ai_badge_label
                        text: '0'
                        halign: 'center'
                        valign: 'middle'
                        theme_text_color: 'Custom'
                        text_color: app.theme_tokens['on_primary']
                        font_size: dp(10)
                        bold: True

        FloatLayout:
            id: ai_banner_container
            size_hint: 1, 1
            pos: 0, 0
