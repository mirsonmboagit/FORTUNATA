<AdminHoverCard@HoverCard>:
    hover_bg_mix: 0.05
    hover_line_mix: 0.24
    hover_elevation_delta: 1.2
    hover_accent_color: app.theme_tokens["primary"]

<AdminActionButton@HoverTooltipRaisedButton>:
    press_enabled: True
    hover_bg_mix: 0.12
    hover_line_mix: 0.22
    hover_elevation_delta: 2
    press_bg_mix: 0.18
    press_line_mix: 0.34
    press_elevation_delta: 0.8
    hover_accent_color: [1, 1, 1, 1]

<AdminScreen>:
    product_table: product_table
    search_input: search_input
    category_spinner: category_spinner

    FloatLayout:
        MDBoxLayout:
            orientation: 'vertical'
            md_bg_color: app.theme_tokens['surface']
            padding: 0
            spacing: 0

            # HEADER - Navegação Principal
            MDTopAppBar:
                id: header_bar
                title: "Gestao de produtos"
                md_bg_color: app.theme_tokens['primary']
                specific_text_color: app.theme_tokens['on_primary']
                elevation: 4
                size_hint_y: None
                height: max(dp(56), root.height * 0.07)
                left_action_items: [["view-dashboard-outline", lambda x: root.go_home(), "Pagina inicial (Alt+1)"]]
                right_action_items: []

            # BARRA DE FERRAMENTAS COMPACTA
            AdminHoverCard:
                id: toolbar_card
                size_hint_y: None
                height: max(dp(78), root.height * 0.09)
                padding: [dp(18), dp(10)]
                spacing: dp(10)
                elevation: 2
                md_bg_color: app.theme_tokens['card']
                radius: [0, 0, 0, 0]

                MDBoxLayout:
                    id: toolbar_row
                    spacing: dp(10)

                    TooltipTextField:
                        id: search_input
                        hint_text: "Pesquisar produto..."
                        tooltip_text: "Pesquisar produto (/ ou Ctrl+F)"
                        mode: "rectangle"
                        size_hint_x: 0.29
                        icon_left: "magnify"
                        on_text: root.queue_filter(self.text)
                        font_size: sp(16)

                    # Filtro de Categorias
                    AdminActionButton:
                        id: category_spinner
                        text: "Todas as Categorias"
                        tooltip_text: "Abrir categorias (Alt+C)"
                        size_hint_x: 0.18
                        md_bg_color: app.theme_tokens['card_alt']
                        theme_text_color: "Custom"
                        text_color: app.theme_tokens['text_primary']
                        hover_accent_color: app.theme_tokens['primary']
                        elevation: 1
                        on_release: root.show_category_menu(self)
                        font_size: sp(15)

                    AdminActionButton:
                        id: filter_btn
                        text: "Filtrar"
                        icon: "filter-variant"
                        tooltip_text: "Alternar filtro KG/unidade/todos (Alt+F)"
                        md_bg_color: app.theme_tokens['warning']
                        theme_text_color: "Custom"
                        text_color: app.theme_tokens['on_primary']
                        hover_accent_color: [1, 1, 1, 1]
                        size_hint_x: None
                        width: dp(48)
                        on_release: root.toggle_kg_products()
                        font_size: sp(14)

                    AdminActionButton:
                        id: refresh_btn
                        text: "Atualizar"
                        icon: "refresh"
                        tooltip_text: "Atualizar lista de produtos (Ctrl+R)"
                        md_bg_color: app.theme_tokens['primary']
                        theme_text_color: "Custom"
                        text_color: app.theme_tokens['on_primary']
                        hover_accent_color: [1, 1, 1, 1]
                        size_hint_x: 0.12
                        on_release: root.refresh_products_panel()
                        font_size: sp(15)

                    AdminActionButton:
                        id: add_btn
                        text: "Adicionar"
                        icon: "plus-circle"
                        tooltip_text: "Adicionar produto (Ctrl+N)"
                        md_bg_color: app.theme_tokens['success']
                        theme_text_color: "Custom"
                        text_color: app.theme_tokens['on_primary']
                        hover_accent_color: [1, 1, 1, 1]
                        size_hint_x: 0.13
                        on_release: root.add_product()
                        font_size: sp(15)

                    AdminActionButton:
                        id: archived_btn
                        text: "Arquivados"
                        icon: "archive-arrow-up-outline"
                        tooltip_text: "Consultar e restaurar produtos arquivados"
                        md_bg_color: app.theme_tokens['primary']
                        theme_text_color: "Custom"
                        text_color: app.theme_tokens['on_primary']
                        size_hint_x: 0.13
                        on_release: root.open_archived_products()
                        font_size: sp(15)

                    AdminActionButton:
                        id: shopping_list_btn
                        text: "Sugestões de Compras"
                        icon: "cart-outline"
                        tooltip_text: "Ver sugestões de compras com IA"
                        md_bg_color: app.theme_tokens['info']
                        theme_text_color: "Custom"
                        text_color: app.theme_tokens['on_primary']
                        hover_accent_color: [1, 1, 1, 1]
                        size_hint_x: 0.18
                        disabled: root.shopping_list_busy
                        on_release: root.open_shopping_list_preview()
                        font_size: sp(15)

                    AdminActionButton:
                        id: inventory_btn
                        text: "Inventario"
                        icon: "clipboard-list-outline"
                        tooltip_text: "Iniciar ou continuar inventario fisico"
                        md_bg_color: app.theme_tokens['warning']
                        theme_text_color: "Custom"
                        text_color: app.theme_tokens['on_primary']
                        hover_accent_color: [1, 1, 1, 1]
                        size_hint_x: 0.14
                        on_release: root.open_physical_inventory()
                        font_size: sp(15)

                    

            # TABELA DE PRODUTOS MELHORADA
            MDBoxLayout:
                size_hint_y: 1
                padding: [dp(12), dp(8), dp(12), dp(12)]

                AdminHoverCard:
                    orientation: 'vertical'
                    spacing: 0
                    elevation: 3
                    md_bg_color: app.theme_tokens['card']
                    radius: [dp(6), dp(6), dp(6), dp(6)]

                    ScrollView:
                        id: table_scroll_x
                        size_hint_y: 1
                        do_scroll_x: True
                        do_scroll_y: False
                        bar_width: dp(6)
                        bar_color: 0.18, 0.28, 0.48, 0.7
                        bar_inactive_color: 0.18, 0.28, 0.48, 0.3
                        effect_cls: "ScrollEffect"

                        MDBoxLayout:
                            id: table_scroll_content
                            orientation: "vertical"
                            size_hint_x: None
                            width: max(root.width, dp(980))
                            size_hint_y: 1

                            MDBoxLayout:
                                id: table_header
                                size_hint_y: None
                                height: max(dp(52), root.height * 0.060)
                                size_hint_x: None
                                width: table_scroll_content.width
                                md_bg_color: app.theme_tokens['surface_alt']
                                padding: [dp(8), 0]
                                canvas.after:
                                    Color:
                                        rgba: app.theme_tokens['divider']
                                    Line:
                                        width: 1
                                        rectangle: self.x, self.y, self.width, self.height

                                MDLabel:
                                    text: "SEQ."
                                    bold: True
                                    size_hint_x: 0.06
                                    halign: "center"
                                    theme_text_color: "Custom"
                                    text_color: app.theme_tokens['text_primary']
                                    font_style: "Subtitle2"
                                    font_size: sp(16)

                                MDLabel:
                                    text: "PRODUTO"
                                    bold: True
                                    size_hint_x: 0.18
                                    halign: "left"
                                    padding: [dp(10), 0]
                                    theme_text_color: "Custom"
                                    text_color: app.theme_tokens['text_primary']
                                    font_style: "Subtitle2"
                                    font_size: sp(16)

                                MDLabel:
                                    text: "ESTOQUE"
                                    bold: True
                                    size_hint_x: 0.09
                                    halign: "center"
                                    theme_text_color: "Custom"
                                    text_color: app.theme_tokens['text_primary']
                                    font_style: "Subtitle2"
                                    font_size: sp(16)

                                MDLabel:
                                    text: "VENDIDO"
                                    bold: True
                                    size_hint_x: 0.09
                                    halign: "center"
                                    theme_text_color: "Custom"
                                    text_color: app.theme_tokens['text_primary']
                                    font_style: "Subtitle2"
                                    font_size: sp(16)

                                MDLabel:
                                    text: "TIPO"
                                    bold: True
                                    size_hint_x: 0.07
                                    halign: "center"
                                    theme_text_color: "Custom"
                                    text_color: app.theme_tokens['text_primary']
                                    font_style: "Subtitle2"
                                    font_size: sp(16)

                                MDLabel:
                                    text: "PRECO"
                                    bold: True
                                    size_hint_x: 0.11
                                    halign: "center"
                                    theme_text_color: "Custom"
                                    text_color: app.theme_tokens['text_primary']
                                    font_style: "Subtitle2"
                                    font_size: sp(16)

                                MDLabel:
                                    text: "LUCRO"
                                    bold: True
                                    size_hint_x: 0.11
                                    halign: "center"
                                    theme_text_color: "Custom"
                                    text_color: app.theme_tokens['text_primary']
                                    font_style: "Subtitle2"
                                    font_size: sp(16)

                                MDLabel:
                                    text: "DATA DE VALIDADE"
                                    bold: True
                                    size_hint_x: 0.15
                                    halign: "center"
                                    theme_text_color: "Custom"
                                    text_color: app.theme_tokens['text_primary']
                                    font_style: "Subtitle2"
                                    font_size: sp(16)

                                MDLabel:
                                    text: "ACOES"
                                    bold: True
                                    size_hint_x: 0.14
                                    halign: "center"
                                    theme_text_color: "Custom"
                                    text_color: app.theme_tokens['text_primary']
                                    font_style: "Subtitle2"
                                    font_size: sp(16)

                            MDSeparator:
                                height: dp(1)
                                color: app.theme_tokens['divider']

                            RecycleView:
                                id: product_table
                                size_hint_x: None
                                width: table_scroll_content.width
                                viewclass: "RecycleAdminProductRow"
                                scroll_type: ["bars", "content"]
                                bar_width: dp(8)
                                bar_color: 0.18, 0.28, 0.48, 0.7
                                bar_inactive_color: 0.18, 0.28, 0.48, 0.3
                                effect_cls: "ScrollEffect"

                                RecycleBoxLayout:
                                    default_size: None, dp(56)
                                    default_size_hint: 1, None
                                    size_hint_y: None
                                    height: self.minimum_height
                                    orientation: "vertical"
                                    spacing: 0

                    MDBoxLayout:
                        size_hint_y: None
                        height: dp(48)
                        padding: [dp(10), dp(4)]
                        spacing: dp(8)

                        AdminActionButton:
                            id: admin_prev_btn
                            text: "Anterior"
                            icon: "chevron-left"
                            tooltip_text: "Pagina anterior"
                            size_hint_x: None
                            width: dp(112)
                            md_bg_color: app.theme_tokens['card_alt']
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['text_primary']
                            font_size: sp(15)
                            disabled: True
                            on_release: root.previous_product_page()

                        MDLabel:
                            id: admin_page_label
                            text: "Pagina 1/1 | 0 itens"
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['text_primary']
                            font_size: sp(14)

                        AdminActionButton:
                            id: admin_next_btn
                            text: "Seguinte"
                            icon: "chevron-right"
                            tooltip_text: "Pagina seguinte"
                            size_hint_x: None
                            width: dp(112)
                            md_bg_color: app.theme_tokens['card_alt']
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['text_primary']
                            font_size: sp(15)
                            disabled: True
                            on_release: root.next_product_page()
        
        FloatLayout:
            id: ai_banner_container
            size_hint: 1, 1
            pos: 0, 0
        
        DraggableTooltipFloatingActionButton:
            id: ai_button
            icon: "assets/icon/alert.png"
            icon_size: dp(38)
            elevation: 0
            md_bg_color: 0, 0, 0, 0
            pos_hint: {"right": 0.965, "y": 0.04}
            hint_text: "Alertas com IA"
            on_release: root.open_ai_menu(self)

        DraggableTooltipFloatingActionButton:
            id: recommendations_button
            icon: "assets/icon/idea.ico"
            icon_size: dp(38)
            elevation: 0
            md_bg_color: 0, 0, 0, 0
            pos: ai_button.x, ai_button.top + dp(10)
            hint_text: "Recomendações com IA"
            on_release: root.show_ai_recommendations(self)

        MDCard:
            id: recommendations_badge
            size_hint: None, None
            size: dp(26), dp(26)
            md_bg_color: app.theme_tokens['badge']
            radius: [dp(13)]
            elevation: 1
            pos: recommendations_button.right - (self.width * 0.55), recommendations_button.top - (self.height * 0.45)
            opacity: 1

            MDLabel:
                id: recommendations_badge_label
                text: "0"
                halign: "center"
                valign: "middle"
                theme_text_color: "Custom"
                text_color: app.theme_tokens['on_primary']
                font_size: dp(12)
                bold: True
        # Badge com número de alertas
        MDCard:
            id: ai_badge
            size_hint: None, None
            size: dp(26), dp(26)
            md_bg_color: app.theme_tokens['badge']
            radius: [dp(13)]
            elevation: 1
            pos: ai_button.right - (self.width * 0.55), ai_button.top - (self.height * 0.45)
            opacity: 1

            MDLabel:
                id: ai_badge_label
                text: "0"
                halign: "center"
                valign: "middle"
                theme_text_color: "Custom"
                text_color: app.theme_tokens['on_primary']
                font_size: dp(12)
                bold: True
