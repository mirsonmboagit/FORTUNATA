                                TooltipRaisedButton:
                                    text: "500"
                                    tooltip_text: "Adicionar nota de 500 MT"
                                    font_size: sp(14)
                                    padding: [dp(4), 0]
                                    md_bg_color: app.theme_tokens['primary']
                                    on_release: root.add_quick_paid_amount(500)

                                TooltipRaisedButton:
                                    text: "1000"
                                    tooltip_text: "Adicionar nota de 1000 MT"
                                    font_size: sp(14)
                                    padding: [dp(2), 0]
                                    md_bg_color: app.theme_tokens['primary']
                                    on_release: root.add_quick_paid_amount(1000)

        AnchorLayout:
            id: action_group_anchor
            anchor_x: "right"
            anchor_y: "center"
            size_hint_y: None
            height: action_group_card.height

            MDCard:
                id: action_group_card
                size_hint: None, None
                width: bottom_actions_grid.minimum_width + dp(16)
                height: bottom_actions_content.minimum_height + dp(16)
                radius: [dp(14)]
                elevation: 1
                md_bg_color: app.theme_tokens['card']
                padding: [dp(8), dp(8), dp(8), dp(8)]

                MDBoxLayout:
                    id: bottom_actions_content
                    orientation: "vertical"
                    spacing: dp(6)

                    MDGridLayout:
                        id: bottom_actions_grid
                        cols: 5
                        spacing: dp(8)
                        size_hint: None, None
                        width: self.minimum_width
                        height: self.minimum_height

                        TooltipRaisedButton:
                            id: cash_btn
                            text: "Caixa"
                            tooltip_text: "Consultar ou fechar caixa"
                            size_hint: None, None
                            width: dp(150)
                            height: dp(50)
                            md_bg_color: app.theme_tokens['warning']
                            font_size: dp(16)
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['on_primary']
                            on_release: root.ensure_cash_session(show_if_open=True)

                        TooltipRaisedButton:
                            id: receipt_btn
                            text: "Recibo"
                            tooltip_text: "Emitir recibo | Ctrl+P"
                            size_hint: None, None
                            width: dp(160)
                            height: dp(50)
                            md_bg_color: app.theme_tokens['primary']
                            font_size: dp(16)
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['on_primary']
                            on_release: root.emit_receipt(print_now=False, preview_after=True)

                        TooltipRaisedButton:
                            id: cancel_btn
                            text: "Cancelar"
                            tooltip_text: "Cancelar venda | Ctrl+0"
                            size_hint: None, None
                            width: dp(162)
                            height: dp(50)
                            md_bg_color: app.theme_tokens['danger']
                            font_size: dp(16)
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['on_primary']
                            on_release: root.cancel_sale()

                        TooltipRaisedButton:
                            id: hold_btn
                            text: root.hold_button_text.replace(" Venda", "")
                            tooltip_text: root.hold_button_text + " | Ctrl+S"
                            size_hint: None, None
                            width: dp(176)
                            height: dp(50)
                            md_bg_color: app.theme_tokens['card_alt']
                            font_size: dp(16)
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['text_primary']
                            on_release: root.toggle_suspend_sale()

                        TooltipRaisedButton:
                            id: finalize_btn
                            text: "Finalizar venda"
                            tooltip_text: "Finalizar venda | Ctrl+Enter"
                            size_hint: None, None
                            width: dp(172)
                            height: dp(50)
                            md_bg_color: app.theme_tokens['success']
                            font_size: dp(16)
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['on_primary']
                            on_release: root.finalize_sale()

        MDCard:
            id: footer_metrics_card
            size_hint_y: None
            height: dp(60)
            radius: [dp(14)]
            elevation: 0
            md_bg_color: app.theme_tokens['surface_alt']
            padding: [dp(10), dp(4), dp(10), dp(4)]

            MDGridLayout:
                id: footer_metrics_grid
                cols: 3
                spacing: dp(8)

                MDCard:
                    radius: [dp(14)]
                    elevation: 0
                    md_bg_color: app.theme_tokens['card_alt']
                    padding: [dp(10), dp(2), dp(10), dp(2)]

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: dp(0)

                        MDLabel:
                            text: "Vendas de Hoje"
                            font_size: dp(14)
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['manager_ink']

                        MDLabel:
                            id: sales_today_metric
                            text: "0"
                            bold: True
                            font_size: dp(16)
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['text_primary']

                MDCard:
                    radius: [dp(14)]
                    elevation: 0
                    md_bg_color: app.theme_tokens['card_alt']
                    padding: [dp(10), dp(2), dp(10), dp(2)]

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: dp(0)

                        MDLabel:
                            text: "Total Vendido"
                            font_size: dp(14)
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['manager_ink']

                        MDLabel:
                            id: revenue_today_metric
                            text: "0.00 MT"
                            bold: True
                            font_size: dp(16)
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['text_primary']

                MDCard:
                    radius: [dp(14)]
                    elevation: 0
                    md_bg_color: app.theme_tokens['card_alt']
                    padding: [dp(10), dp(2), dp(10), dp(2)]

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: dp(0)

                        MDLabel:
                            text: "Produto mais vendido"
                            font_size: dp(14)
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['manager_ink']

                        MDLabel:
                            id: top_product_metric
                            text: "Sem dados"
                            bold: True
                            font_size: dp(16)
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['text_primary']
                            shorten: True
                            shorten_from: "right"

    FloatLayout:
        size_hint: 1, 1

        FloatLayout:
            id: ai_banner_container
            size_hint: 1, 1
            pos: 0, 0

        FloatingScannerPanel:
            id: scanner_preview_card

        MDCard:
            id: notice_overlay_card
            size_hint: None, None
            size: dp(340), dp(150)
            radius: [dp(18)]
            elevation: 4
            md_bg_color: app.theme_tokens['surface_alt'][0], app.theme_tokens['surface_alt'][1], app.theme_tokens['surface_alt'][2], 0.98
            padding: [dp(14), dp(12), dp(14), dp(12)]
            spacing: dp(8)
            orientation: "vertical"
            opacity: 0
            disabled: True

            MDBoxLayout:
                size_hint_y: None
                height: dp(24)
                spacing: dp(8)

                MDLabel:
                    id: notice_overlay_title
                    text: ""
                    bold: True
                    font_size: dp(15)
                    valign: "middle"
                    shorten: True
                    shorten_from: "right"
                    theme_text_color: "Custom"
                    text_color: app.theme_tokens['text_primary']

                TooltipIconButton:
                    icon: "close"
                    icon_size: sp(18)
                    theme_text_color: "Custom"
                    text_color: app.theme_tokens['text_primary']
                    md_bg_color: app.theme_tokens['card_alt']
                    hint_text: "Fechar detalhes | Esc"
                    on_release: root.close_notice_overlay()

            ScrollView:
                do_scroll_x: False
                bar_width: dp(5)

                MDLabel:
                    id: notice_overlay_body
                    text: ""
                    font_size: dp(14)
                    line_height: 1.18
                    theme_text_color: "Custom"
                    text_color: app.theme_tokens['manager_ink']
                    valign: "top"
                    text_size: max(self.width - dp(4), dp(40)), None
                    size_hint_y: None
                    height: self.texture_size[1]

        DraggableTooltipFloatingActionButton:
            id: ai_button
            icon: "assets/icon/alert.png"
            icon_size: dp(38)
            elevation: 0
            md_bg_color: 0, 0, 0, 0
            pos_hint: {"right": 0.972, "y": 0.03}
            hint_text: "Alertas com IA"
            on_release: root.show_manager_ai_alerts(self)

        DraggableTooltipFloatingActionButton:
            id: recommendations_button
            icon: "assets/icon/idea.ico"
            icon_size: dp(38)
            elevation: 0
            md_bg_color: 0, 0, 0, 0
            pos: ai_button.x, ai_button.top + dp(10)
            hint_text: "Recomendações com IA"
            on_release: root.show_manager_ai_recommendations(self)

        MDCard:
            id: recommendations_badge
            size_hint: None, None
            size: dp(26), dp(26)
            md_bg_color: app.theme_tokens["badge"] if "badge" in app.theme_tokens else app.theme_tokens["danger"]
            radius: [dp(13)]
            elevation: 1
            pos: recommendations_button.right - (self.width * 0.55), recommendations_button.top - (self.height * 0.45)
            opacity: 1

            MDLabel:
                id: recommendations_badge_label
                text: "0"
                halign: "center"
                valign: "middle"
                bold: True
                font_size: dp(12)
                theme_text_color: "Custom"
                text_color: app.theme_tokens["on_primary"]
                text_size: self.size

        MDCard:
            id: ai_badge
            size_hint: None, None
            size: dp(26), dp(26)
            md_bg_color: app.theme_tokens["badge"] if "badge" in app.theme_tokens else app.theme_tokens["danger"]
            radius: [dp(13)]
            elevation: 1
            pos: ai_button.right - (self.width * 0.55), ai_button.top - (self.height * 0.45)
            opacity: 1

            MDLabel:
                id: ai_badge_label
                text: "0"
                halign: "center"
                valign: "middle"
                bold: True
                font_size: dp(14)
                theme_text_color: "Custom"
                text_color: app.theme_tokens["on_primary"]
                text_size: self.size
