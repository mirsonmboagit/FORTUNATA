#:kivy 2.0

<QuickProductCard>:
    orientation: "vertical"
    size_hint_y: None
    height: dp(94)
    padding: [dp(12), dp(10), dp(12), dp(10)]
    spacing: 0
    radius: [dp(12)]
    elevation: 1
    md_bg_color: app.theme_tokens['card']

    MDBoxLayout:
        id: compact_product_name_row
        size_hint_y: None
        height: 0
        opacity: 0
        disabled: True

        MDLabel:
            id: compact_product_name
            text: ""
            bold: True
            font_size: dp(16)
            theme_text_color: "Custom"
            text_color: app.theme_tokens['text_primary']
            shorten: False
            max_lines: 2
            valign: "middle"
            text_size: self.width, None

        MDLabel:
            id: compact_product_price
            text: ""
            size_hint_x: None
            width: dp(90)
            halign: "right"
            valign: "middle"
            bold: True
            font_size: dp(17)
            theme_text_color: "Custom"
            text_color: app.theme_tokens['success']
            text_size: self.size

    MDBoxLayout:
        id: product_content_row
        orientation: "horizontal"
        spacing: dp(10)

        MDCard:
            id: product_icon_shell
            size_hint: None, None
            size: dp(50), dp(50)
            radius: [dp(10)]
            elevation: 0
            md_bg_color: app.theme_tokens['card_alt']

            AnchorLayout:
                anchor_x: "center"
                anchor_y: "center"

                MDIcon:
                    id: product_icon
                    icon: "package-variant-closed"
                    size_hint: None, None
                    size: dp(26), dp(26)
                    text_size: self.size
                    halign: "center"
                    valign: "middle"
                    theme_text_color: "Custom"
                    text_color: app.theme_tokens['info']
                    font_size: dp(26)

        MDBoxLayout:
            id: product_info_box
            orientation: "vertical"
            spacing: dp(2)

            MDLabel:
                id: product_name_label
                text: ""
                bold: True
                font_size: dp(16)
                theme_text_color: "Custom"
                text_color: app.theme_tokens['text_primary']
                shorten: True
                shorten_from: "right"

            MDLabel:
                id: product_meta_label
                text: ""
                font_size: dp(15)
                theme_text_color: "Custom"
                text_color: app.theme_tokens['manager_ink']
                shorten: True
                shorten_from: "right"

        MDLabel:
            id: compact_stock_label
            text: ""
            bold: True
            font_size: dp(15)
            valign: "middle"
            theme_text_color: "Custom"
            text_color: app.theme_tokens['manager_ink']
            opacity: 1
            disabled: True

        MDBoxLayout:
            id: product_price_box
            orientation: "vertical"
            size_hint_x: None
            width: dp(104)
            spacing: dp(1)

            MDLabel:
                id: product_price_label
                text: ""
                halign: "right"
                bold: True
                font_size: dp(18)
                theme_text_color: "Custom"
                text_color: app.theme_tokens['success']

            MDLabel:
                id: product_mode_label
                text: ""
                halign: "right"
                font_size: dp(15)
                theme_text_color: "Custom"
                text_color: app.theme_tokens['manager_ink']

        MDBoxLayout:
            id: product_actions_row
            orientation: "horizontal"
            size_hint_x: None
            width: dp(144)
            spacing: dp(6)

            TooltipIconButton:
                id: view_product_btn
                icon: "eye-outline"
                icon_size: sp(22)
                size_hint: None, None
                size: dp(42), dp(42)
                theme_text_color: "Custom"
                text_color: app.theme_tokens['text_primary']
                md_bg_color: app.theme_tokens['card_alt']
                hint_text: "Ver detalhes do produto"
                on_release: root.on_view_details_click()

            TooltipIconButton:
                id: add_unit_btn
                icon: "plus"
                icon_size: sp(22)
                size_hint: None, None
                size: dp(42), dp(42)
                theme_text_color: "Custom"
                text_color: app.theme_tokens['on_primary']
                md_bg_color: app.theme_tokens['primary']
                hint_text: "Adicionar unidade | Enter na pesquisa"
                on_release: root.on_add_unit_click()

            TooltipIconButton:
                id: add_pack_btn
                icon: "package-variant-closed-plus"
                icon_size: sp(22)
                size_hint: None, None
                size: dp(42), dp(42)
                theme_text_color: "Custom"
                text_color: app.theme_tokens['on_primary']
                md_bg_color: app.theme_tokens['success']
                hint_text: "Adicionar embalagem"
                on_release: root.on_add_pack_click()


<FloatingScannerPanel>:
    orientation: "vertical"
    size_hint: None, None
    size: dp(380), dp(450)
    radius: [dp(18)]
    elevation: 6
    md_bg_color: app.theme_tokens['surface'][0], app.theme_tokens['surface'][1], app.theme_tokens['surface'][2], 0.98
    padding: [dp(14), dp(14), dp(14), dp(14)]
    spacing: dp(8)
    opacity: 0
    disabled: True

    MDBoxLayout:
        size_hint_y: None
        height: dp(44)
        spacing: dp(9)

        MDCard:
            size_hint: None, None
            size: dp(42), dp(42)
            radius: [dp(12)]
            elevation: 0
            md_bg_color: app.theme_tokens['primary'][0], app.theme_tokens['primary'][1], app.theme_tokens['primary'][2], 0.12

            MDIcon:
                icon: "barcode-scan"
                halign: "center"
                valign: "middle"
                text_size: self.size
                font_size: dp(24)
                theme_text_color: "Custom"
                text_color: app.theme_tokens['primary']

        MDBoxLayout:
            orientation: "vertical"
            spacing: dp(1)

            MDLabel:
                text: "Leitor de código de barras"
                bold: True
                size_hint_y: None
                height: dp(22)
                font_size: dp(15)
                shorten: True
                shorten_from: "right"
                theme_text_color: "Custom"
                text_color: app.theme_tokens['text_primary']

            MDLabel:
                text: "Aponte a câmara para o código de barras"
                size_hint_y: None
                height: dp(17)
                font_size: dp(12)
                shorten: True
                shorten_from: "right"
                theme_text_color: "Custom"
                text_color: app.theme_tokens['manager_ink']

        Widget:

        TooltipIconButton:
            icon: "close"
            icon_size: sp(24)
            size_hint: None, None
            size: dp(40), dp(40)
            theme_text_color: "Custom"
            text_color: app.theme_tokens['manager_ink']
            md_bg_color: app.theme_tokens['card_alt']
            hint_text: "Fechar leitor"
            on_release: app.root.get_screen("manager").stop_scanner() if app.root and "manager" in app.root.screen_names else None

    MDCard:
        size_hint_y: None
        height: dp(174)
        radius: [dp(15)]
        elevation: 0
        md_bg_color: 0.08, 0.10, 0.15, 1

        FloatLayout:
            id: scanner_camera_view

            # A pre-visualizacao ocupa rigorosamente o card. Sem este
            # enquadramento explicito, a textura da camara pode manter uma
            # geometria anterior e aparecer fora do painel.
            canvas.after:
                Color:
                    rgba: 1, 1, 1, 0.92
                Line:
                    width: dp(3)
                    points: [self.x + dp(18), self.top - dp(18), self.x + dp(42), self.top - dp(18), self.x + dp(42), self.top - dp(42)]
                Line:
                    width: dp(3)
                    points: [self.right - dp(18), self.top - dp(18), self.right - dp(42), self.top - dp(18), self.right - dp(42), self.top - dp(42)]
                Line:
                    width: dp(3)
                    points: [self.x + dp(18), self.y + dp(18), self.x + dp(42), self.y + dp(18), self.x + dp(42), self.y + dp(42)]
                Line:
                    width: dp(3)
                    points: [self.right - dp(18), self.y + dp(18), self.right - dp(42), self.y + dp(18), self.right - dp(42), self.y + dp(42)]
                Color:
                    rgba: app.theme_tokens['primary'][0], app.theme_tokens['primary'][1], app.theme_tokens['primary'][2], 0.95
                Line:
                    width: dp(2)
                    points: [self.x + dp(30), self.center_y, self.right - dp(30), self.center_y]

            Image:
                id: camera_image
                size_hint: None, None
                size: self.parent.size
                pos: self.parent.pos
                fit_mode: "fill"

            MDBoxLayout:
                orientation: "vertical"
                size_hint: None, None
                size: dp(205), dp(82)
                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                spacing: dp(8)

                MDIcon:
                    icon: "barcode"
                    halign: "center"
                    font_size: dp(38)
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 0.68

                MDLabel:
                    text: "Posicione o código de barras\nna área indicada"
                    halign: "center"
                    font_size: dp(14)
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 0.80

    MDCard:
        size_hint_y: None
        height: dp(62)
        radius: [dp(14)]
        elevation: 0
        md_bg_color: app.theme_tokens['card_alt']
        padding: [dp(12), dp(7), dp(12), dp(6)]

        MDBoxLayout:
            orientation: "vertical"
            spacing: dp(1)

            MDLabel:
                text: "Lido:"
                bold: True
                font_size: dp(12)
                theme_text_color: "Custom"
                text_color: app.theme_tokens['manager_ink']

            MDLabel:
                id: scanner_last_value
                text: "A aguardar leitura"
                bold: True
                font_size: dp(17)
                shorten: True
                shorten_from: "right"
                theme_text_color: "Custom"
                text_color: app.theme_tokens['text_primary']

            MDLabel:
                id: scanner_status_label
                text: "Prepare a câmara para começar"
                font_size: dp(11)
                shorten: True
                shorten_from: "right"
                theme_text_color: "Custom"
                text_color: app.theme_tokens['manager_ink']

    MDBoxLayout:
        size_hint_y: None
        height: dp(40)
        spacing: dp(8)

        TooltipRaisedButton:
            text: "Parar"
            tooltip_text: "Parar leitor | Ctrl+B"
            size_hint_x: 0.9
            md_bg_color: app.theme_tokens['danger']
            on_release: app.root.get_screen("manager").toggle_scanner() if app.root and "manager" in app.root.screen_names else None

        TooltipRaisedButton:
            text: "Trocar câmara"
            tooltip_text: "Trocar câmara | Ctrl+K"
            size_hint_x: 1.1
            md_bg_color: app.theme_tokens['primary']
            on_release: app.root.get_screen("manager").switch_camera() if app.root and "manager" in app.root.screen_names else None

    MDCard:
        size_hint_y: None
        height: dp(66)
        radius: [dp(14)]
        elevation: 0
        md_bg_color: app.theme_tokens['primary'][0], app.theme_tokens['primary'][1], app.theme_tokens['primary'][2], 0.10
        padding: [dp(10), dp(7), dp(10), dp(7)]

        MDBoxLayout:
            spacing: dp(10)

            MDIcon:
                icon: "lightbulb-on-outline"
                size_hint_x: None
                width: dp(24)
                halign: "center"
                valign: "middle"
                text_size: self.size
                font_size: dp(22)
                theme_text_color: "Custom"
                text_color: app.theme_tokens['primary']

            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(1)

                MDLabel:
                    text: "Dica"
                    bold: True
                    size_hint_y: None
                    height: dp(17)
                    font_size: dp(12)
                    theme_text_color: "Custom"
                    text_color: app.theme_tokens['primary']

                MDLabel:
                    text: "Mantenha a câmara focada, estável e com boa iluminação para uma leitura rápida."
                    size_hint_y: None
                    height: self.texture_size[1]
                    font_size: dp(11)
                    theme_text_color: "Custom"
                    text_color: app.theme_tokens['manager_ink']
                    text_size: self.width, None
                    valign: "middle"


<SalesScreen>:
    name: "manager"
    md_bg_color: app.theme_tokens['surface']

    MDBoxLayout:
        orientation: "vertical"
        padding: [dp(12), dp(12), dp(12), dp(12)]
        spacing: dp(10)

        MDCard:
            id: header_card
            size_hint_y: None
            height: dp(72)
            radius: [dp(12)]
            elevation: 1
            md_bg_color: app.theme_tokens['card']
            padding: [dp(16), dp(8), dp(16), dp(8)]

            MDBoxLayout:
                id: header_content
                spacing: dp(14)

                MDBoxLayout:
                    id: brand_group
                    size_hint_x: 0.43
                    spacing: dp(12)

                    MDCard:
                        size_hint: None, None
                        size: dp(50), dp(50)
                        radius: [dp(10)]
                        elevation: 0
                        md_bg_color: app.theme_tokens['primary']

                        AnchorLayout:
                            anchor_x: "center"
                            anchor_y: "center"

                            MDIcon:
                                icon: "storefront-outline"
                                size_hint: None, None
                                size: dp(26), dp(26)
                                text_size: self.size
                                halign: "center"
                                valign: "middle"
                                font_size: dp(26)
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['on_primary']

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: dp(2)

                        MDLabel:
                            text: app.system_name
                            bold: True
                            font_style: "H6"
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['text_primary']

                MDBoxLayout:
                    id: header_meta_group
                    size_hint_x: 0.23
                    spacing: dp(12)

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: dp(2)

                        MDLabel:
                            text: "Atendente"
                            font_size: dp(14)
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['manager_ink']

                        MDLabel:
                            id: operator_label
                            text: root.operator_name
                            bold: True
                            font_size: dp(16)
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['text_primary']

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: dp(2)

                        MDLabel:
                            text: "Ultima alteracao"
                            font_size: dp(14)
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['manager_ink']

                        MDLabel:
                            id: datetime_label
                            text: root.header_datetime_text
                            bold: True
                            font_size: dp(15)
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['text_primary']

                MDBoxLayout:
                    id: header_actions
                    size_hint_x: 0.34
                    spacing: dp(8)

                    Widget:

                    MDCard:
                        id: connection_card
                        size_hint: None, None
                        size: dp(112), dp(38)
                        radius: [dp(16)]
                        elevation: 0
                        md_bg_color: app.theme_tokens['success'][0], app.theme_tokens['success'][1], app.theme_tokens['success'][2], 0.16
                        padding: [dp(12), 0, dp(12), 0]

                        MDBoxLayout:
                            spacing: dp(8)

                            AnchorLayout:
                                size_hint_x: None
                                width: dp(20)
                                anchor_x: "center"
                                anchor_y: "center"

                                MDCard:
                                    size_hint: None, None
                                    size: dp(14), dp(14)
                                    radius: [dp(7)]
                                    elevation: 0
                                    md_bg_color: app.theme_tokens['success']

                            MDLabel:
                                id: connection_label
                                text: "Online"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_primary']

                    TooltipIconButton:
                        icon: "history"
                        icon_size: sp(20)
                        theme_text_color: "Custom"
                        text_color: app.theme_tokens['text_primary']
                        md_bg_color: app.theme_tokens['card_alt']
                        hint_text: "Historico de vendas | Ctrl+H"
                        on_release: root.open_sales_history()

                    TooltipIconButton:
                        icon: "alert-circle-outline"
                        icon_size: sp(20)
                        theme_text_color: "Custom"
                        text_color: app.theme_tokens['text_primary']
                        md_bg_color: app.theme_tokens['card_alt']
                        hint_text: "Registar perdas | Ctrl+D"
                        on_release: root.open_losses_screen()

                    TooltipIconButton:
                        icon: "refresh"
                        icon_size: sp(20)
                        theme_text_color: "Custom"
                        text_color: app.theme_tokens['text_primary']
                        md_bg_color: app.theme_tokens['card_alt']
                        hint_text: "Atualizar painel | Ctrl+R"
                        on_release: root.refresh_products_panel()

                    TooltipIconButton:
                        icon: "logout"
                        icon_size: sp(20)
                        theme_text_color: "Custom"
                        text_color: app.theme_tokens['text_primary']
                        md_bg_color: app.theme_tokens['danger'][0], app.theme_tokens['danger'][1], app.theme_tokens['danger'][2], 0.22
                        hint_text: "Terminar sessao | Ctrl+Backspace"
                        on_release: root.return_to_login()

        MDBoxLayout:
            id: notices_bar
            size_hint_y: None
            height: max(notice_one_card.height, notice_two_card.height, notice_three_card.height)
            spacing: dp(8)

            NoticeBannerCard:
                id: notice_one_card
                orientation: "vertical"
                size_hint_y: None
                height: dp(56) + notice_one_details_shell.height
                radius: [dp(12)]
                elevation: 0
                md_bg_color: app.theme_tokens['card']
                padding: [dp(0), dp(0), dp(10), dp(0)]
                on_touch_up:
                    if self.collide_point(*args[1].pos): root.open_notice_detail("one")

                MDBoxLayout:
                    id: notice_one_main_row
                    size_hint_y: None
                    height: dp(56)
                    spacing: dp(0)

                    MDBoxLayout:
                        size_hint_x: None
                        width: dp(4)
                        canvas.before:
                            Color:
                                rgba: app.theme_tokens['warning']
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(12), dp(0), dp(0), dp(12)]

                    MDBoxLayout:
                        spacing: dp(6)
                        padding: [dp(10), dp(6), dp(0), dp(6)]

                        AnchorLayout:
                            size_hint_x: None
                            width: dp(24)
                            anchor_x: "center"
                            anchor_y: "center"

                            MDIcon:
                                id: notice_one_icon
                                icon: "alert-outline"
                                size_hint: None, None
                                size: dp(18), dp(18)
                                text_size: self.size
                                halign: "center"
                                valign: "middle"
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['warning']
                                font_size: dp(18)

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(2)

                            MDLabel:
                                id: notice_one_title
                                text: "Stock"
                                bold: True
                                font_size: dp(15)
                                valign: "middle"
                                shorten: True
                                shorten_from: "right"
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_primary']

                            MDLabel:
                                id: notice_one_body
                                text: "Sem alertas de stock."
                                font_size: dp(15)
                                valign: "middle"
                                shorten: True
                                shorten_from: "right"
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['manager_ink']

                        AnchorLayout:
                            size_hint_x: None
                            width: dp(26)
                            anchor_x: "center"
                            anchor_y: "center"

                            MDIcon:
                                id: notice_one_toggle_icon
                                icon: "chevron-right"
                                halign: "center"
                                font_size: dp(18)
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['manager_ink']

                MDBoxLayout:
                    id: notice_one_details_shell
                    size_hint_y: None
                    height: 0
                    opacity: 0
                    padding: [dp(14), 0, dp(14), dp(10)]

                    MDLabel:
                        id: notice_one_detail_body
                        text: ""
                        font_size: dp(15)
                        theme_text_color: "Custom"
                        text_color: app.theme_tokens['manager_ink']
                        valign: "top"
                        text_size: max(self.width - dp(4), dp(40)), None
                        size_hint_y: None
                        height: self.texture_size[1]

            NoticeBannerCard:
                id: notice_two_card
                orientation: "vertical"
                size_hint_y: None
                height: dp(56) + notice_two_details_shell.height
                radius: [dp(12)]
                elevation: 0
                md_bg_color: app.theme_tokens['card']
                padding: [dp(0), dp(0), dp(10), dp(0)]
                on_touch_up:
                    if self.collide_point(*args[1].pos): root.open_notice_detail("two")

                MDBoxLayout:
                    id: notice_two_main_row
                    size_hint_y: None
                    height: dp(56)
                    spacing: dp(0)

                    MDBoxLayout:
                        size_hint_x: None
                        width: dp(4)
                        canvas.before:
                            Color:
                                rgba: app.theme_tokens['info']
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(12), dp(0), dp(0), dp(12)]

                    MDBoxLayout:
                        spacing: dp(6)
                        padding: [dp(10), dp(6), dp(0), dp(6)]

                        AnchorLayout:
                            size_hint_x: None
                            width: dp(24)
                            anchor_x: "center"
                            anchor_y: "center"

                            MDIcon:
                                id: notice_two_icon
                                icon: "chart-line"
                                size_hint: None, None
                                size: dp(18), dp(18)
                                text_size: self.size
                                halign: "center"
                                valign: "middle"
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['info']
                                font_size: dp(18)

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(2)

                            MDLabel:
                                id: notice_two_title
                                text: "Mais vendido"
                                bold: True
                                font_size: dp(15)
                                valign: "middle"
                                shorten: True
                                shorten_from: "right"
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_primary']

                            MDLabel:
                                id: notice_two_body
                                text: "Sem vendas hoje."
                                font_size: dp(15)
                                valign: "middle"
                                shorten: True
                                shorten_from: "right"
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['manager_ink']

                        AnchorLayout:
                            size_hint_x: None
                            width: dp(26)
                            anchor_x: "center"
                            anchor_y: "center"

                            MDIcon:
                                id: notice_two_toggle_icon
                                icon: "chevron-right"
                                halign: "center"
                                font_size: dp(18)
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['manager_ink']

                MDBoxLayout:
                    id: notice_two_details_shell
                    size_hint_y: None
                    height: 0
                    opacity: 0
                    padding: [dp(14), 0, dp(14), dp(10)]

                    MDLabel:
                        id: notice_two_detail_body
                        text: ""
                        font_size: dp(15)
                        theme_text_color: "Custom"
                        text_color: app.theme_tokens['manager_ink']
                        valign: "top"
                        text_size: max(self.width - dp(4), dp(40)), None
                        size_hint_y: None
                        height: self.texture_size[1]

            NoticeBannerCard:
                id: notice_three_card
                orientation: "vertical"
                size_hint_y: None
                height: dp(56) + notice_three_details_shell.height
                radius: [dp(12)]
                elevation: 0
                md_bg_color: app.theme_tokens['card']
                padding: [dp(0), dp(0), dp(10), dp(0)]
                on_touch_up:
                    if self.collide_point(*args[1].pos): root.open_notice_detail("three")

                MDBoxLayout:
                    id: notice_three_main_row
                    size_hint_y: None
                    height: dp(56)
                    spacing: dp(0)

                    MDBoxLayout:
                        size_hint_x: None
                        width: dp(4)
                        canvas.before:
                            Color:
                                rgba: app.theme_tokens['success']
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(12), dp(0), dp(0), dp(12)]

                    MDBoxLayout:
                        spacing: dp(8)
                        padding: [dp(10), dp(6), dp(0), dp(6)]

                        AnchorLayout:
                            size_hint_x: None
                            width: dp(24)
                            anchor_x: "center"
                            anchor_y: "center"

                            MDIcon:
                                id: notice_three_icon
                                icon: "clock-outline"
                                size_hint: None, None
                                size: dp(18), dp(18)
                                text_size: self.size
                                halign: "center"
                                valign: "middle"
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['success']
                                font_size: dp(18)

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(2)

                            MDLabel:
                                id: notice_three_title
                                text: "Hora de maior movimento"
                                bold: True
                                font_size: dp(15)
                                valign: "middle"
                                shorten: True
                                shorten_from: "right"
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_primary']

                            MDLabel:
                                id: notice_three_body
                                text: "Ainda sem dados."
                                font_size: dp(15)
                                valign: "middle"
                                shorten: True
                                shorten_from: "right"
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['manager_ink']

                        AnchorLayout:
                            size_hint_x: None
                            width: dp(26)
                            anchor_x: "center"
                            anchor_y: "center"

                            MDIcon:
                                id: notice_three_toggle_icon
                                icon: "chevron-right"
                                halign: "center"
                                font_size: dp(18)
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['manager_ink']

                MDBoxLayout:
                    id: notice_three_details_shell
                    size_hint_y: None
                    height: 0
                    opacity: 0
                    padding: [dp(14), 0, dp(14), dp(10)]

                    MDLabel:
                        id: notice_three_detail_body
                        text: ""
                        font_size: dp(15)
                        theme_text_color: "Custom"
                        text_color: app.theme_tokens['manager_ink']
                        valign: "top"
                        text_size: max(self.width - dp(4), dp(40)), None
                        size_hint_y: None
                        height: self.texture_size[1]

        MDBoxLayout:
            id: body_shell
            orientation: "horizontal"
            spacing: dp(8)

            MDCard:
                id: workspace_card
                size_hint_x: 0.31
                radius: [dp(18)]
                elevation: 2
                md_bg_color: app.theme_tokens['surface_alt']
                padding: [dp(12), dp(12), dp(12), dp(12)]

                MDBoxLayout:
                    orientation: "vertical"
                    spacing: dp(8)

                    MDBoxLayout:
                        size_hint_y: None
                        height: dp(26)

                        MDLabel:
                            text: "Produtos"
                            bold: True
                            font_style: "H6"
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['text_primary']

                        MDLabel:
                            id: product_results_label
                            text: "0 produtos"
                            halign: "right"
                            font_size: dp(14)
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['manager_ink']

                    MDCard:
                        id: search_shell_card
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
                        padding: [dp(12), dp(12), dp(12), dp(12)]
                        spacing: dp(8)
                        radius: [dp(16)]
                        elevation: 0
                        md_bg_color: app.theme_tokens['card_alt']

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(52)
                            spacing: dp(6)

                            MDTextField:
                                id: search_input
                                hint_text: "Pesquisar produto"
                                mode: "rectangle"
                                multiline: False
                                font_size: dp(16)
                                line_color_normal: app.theme_tokens['divider']
                                line_color_focus: app.theme_tokens['primary']
                                text_color_normal: app.theme_tokens['text_primary']
                                text_color_focus: app.theme_tokens['text_primary']
                                hint_text_color_normal: app.theme_tokens['manager_ink']
                                on_text: root.on_search(self.text)
                                on_text_validate: root.on_search_enter()

                            TooltipIconButton:
                                id: clear_search_btn
                                icon: "close"
                                icon_size: sp(22)
                                size_hint: None, None
                                size: dp(42), dp(42)
                                width: dp(42) if search_input.text else 0
                                opacity: 1 if search_input.text else 0
                                disabled: not bool(search_input.text)
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_primary']
                                md_bg_color: app.theme_tokens['card_alt']
                                hint_text: "Limpar pesquisa | Ctrl+L"
                                on_release: root.clear_search()

                            TooltipIconButton:
                                id: show_all_products_btn
                                icon: "format-list-bulleted"
                                icon_size: sp(22)
                                size_hint: None, None
                                size: dp(42), dp(42)
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_primary']
                                md_bg_color: app.theme_tokens['card_alt']
                                hint_text: "Ver catalogo de produtos"
                                on_release: root.open_all_products_table()

                            TooltipIconButton:
                                id: scan_toggle_btn
                                icon: "barcode-scan"
                                icon_size: sp(22)
                                size_hint: None, None
                                size: dp(42), dp(42)
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['on_primary']
                                md_bg_color: app.theme_tokens['success']
                                hint_text: "Ligar ou desligar scanner | Ctrl+B"
                                on_release: root.toggle_scanner()

                        MDCard:
                            id: search_feedback_card
                            size_hint_y: None
                            height: 0
                            opacity: 0
                            disabled: True
                            radius: [dp(12)]
                            elevation: 0
                            md_bg_color: app.theme_tokens['success'][0], app.theme_tokens['success'][1], app.theme_tokens['success'][2], 0.18
                            padding: [dp(10), 0, dp(10), 0]

                            MDBoxLayout:
                                spacing: dp(8)

                                AnchorLayout:
                                    size_hint_x: None
                                    width: dp(20)
                                    anchor_x: "center"
                                    anchor_y: "center"

                                    MDIcon:
                                        id: search_feedback_icon
                                        icon: "check-circle"
                                        size_hint: None, None
                                        size: dp(16), dp(16)
                                        text_size: self.size
                                        halign: "center"
                                        valign: "middle"
                                        theme_text_color: "Custom"
                                        text_color: app.theme_tokens['success']
                                        font_size: dp(16)

                                MDLabel:
                                    id: search_feedback_label
                                    text: "Pronto"
                                    font_size: dp(15)
                                    bold: True
                                    theme_text_color: "Custom"
                                    text_color: app.theme_tokens['text_primary']

                        MDCard:
                            id: scanner_preview_card_inline
                            orientation: "horizontal"
                            size_hint_y: None
                            height: 0
                            opacity: 0
                            radius: [dp(14)]
                            elevation: 0
                            md_bg_color: app.theme_tokens['surface_alt']
                            padding: [dp(8), dp(8), dp(8), dp(8)]
                            spacing: dp(10)

                            MDCard:
                                size_hint_x: None
                                width: dp(148)
                                radius: [dp(12)]
                                elevation: 0
                                md_bg_color: app.theme_tokens['card_alt']

                                Image:
                                    id: camera_image_inline
                                    fit_mode: "contain"

                            MDBoxLayout:
                                orientation: "vertical"
                                spacing: dp(6)

                                MDLabel:
                                    text: "Scanner ativo"
                                    bold: True
                                    font_style: "Subtitle2"
                                    theme_text_color: "Custom"
                                    text_color: app.theme_tokens['text_primary']

                                MDLabel:
                                    id: scanner_status_label_inline
                                    text: "A preparar a camera..."
                                    font_size: dp(14)
                                    theme_text_color: "Custom"
                                    text_color: app.theme_tokens['manager_ink']

                                MDBoxLayout:
                                    size_hint_y: None
                                    height: dp(36)
                                    spacing: dp(8)

                                    TooltipRaisedButton:
                                        text: "Parar"
                                        tooltip_text: "Parar scanner | Ctrl+B"
                                        md_bg_color: app.theme_tokens['danger']
                                        on_release: root.toggle_scanner()

                                    TooltipRaisedButton:
                                        text: "Cam"
                                        tooltip_text: "Trocar camera | Ctrl+K"
                                        md_bg_color: app.theme_tokens['primary']
                                        on_release: root.switch_camera()

                    MDCard:
                        id: product_results_card
                        orientation: "vertical"
                        radius: [dp(14)]
                        elevation: 0
                        md_bg_color: app.theme_tokens['surface_alt']
                        padding: [dp(10), dp(10), dp(10), dp(10)]
                        spacing: dp(8)

                        RecycleView:
                            id: product_matches_rv
                            viewclass: "RecycleQuickProductCard"
                            scroll_type: ["bars", "content"]
                            bar_width: dp(6)
                            do_scroll_x: False
                            on_scroll_y: root.on_products_scroll(self.scroll_y)

                            RecycleBoxLayout:
                                default_size: None, dp(94)
                                default_size_hint: 1, None
                                size_hint_y: None
                                height: self.minimum_height
                                orientation: "vertical"
                                spacing: dp(8)

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(40)
                            spacing: dp(6)

                            TooltipIconButton:
                                id: product_prev_btn
                                icon: "chevron-left"
                                hint_text: "Pagina anterior"
                                md_bg_color: app.theme_tokens['card_alt']
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_primary']
                                disabled: True
                                on_release: root.previous_products_page()

                            MDLabel:
                                id: product_page_label
                                text: "Pagina 1"
                                halign: "center"
                                font_size: dp(14)
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['manager_ink']

                            TooltipIconButton:
                                id: product_next_btn
                                icon: "chevron-right"
                                hint_text: "Pagina seguinte"
                                md_bg_color: app.theme_tokens['card_alt']
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_primary']
                                disabled: True
                                on_release: root.next_products_page()

            MDCard:
                id: cart_card
                size_hint_x: 0.43
                radius: [dp(18)]
                elevation: 2
                md_bg_color: app.theme_tokens['surface_alt']
                padding: [dp(12), dp(12), dp(12), dp(12)]

                MDBoxLayout:
                    orientation: "vertical"
                    spacing: dp(8)

                    MDBoxLayout:
                        size_hint_y: None
                        height: dp(30)
                        spacing: dp(8)

                        MDLabel:
                            text: "Carrinho"
                            bold: True
                            font_style: "H6"
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['text_primary']

                        MDLabel:
                            id: cart_count_label
                            text: "0 itens"
                            halign: "right"
                            font_size: dp(14)
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['manager_ink']

                    MDBoxLayout:
                        size_hint_y: None
                        height: dp(36)
                        spacing: dp(6)
                        padding: [dp(10), 0, dp(8), 0]

                        canvas.before:
                            Color:
                                rgba: app.theme_tokens['card_alt']
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(10), dp(10), dp(10), dp(10)]

                        MDLabel:
                            text: "Produto"
                            bold: True
                            font_size: dp(15)
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['text_primary']
                            size_hint_x: 0.45

                        MDLabel:
                            text: "Qtd"
                            halign: "center"
                            bold: True
                            font_size: dp(15)
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['text_primary']
                            size_hint_x: 0.28

                        MDLabel:
                            text: "Total"
                            halign: "right"
                            bold: True
                            font_size: dp(15)
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['text_primary']
                            size_hint_x: 0.23

                        MDLabel:
                            text: ""
                            size_hint_x: None
                            width: dp(34)

                    MDBoxLayout:
                        orientation: "vertical"

                        ScrollView:
                            do_scroll_x: False

                            MDBoxLayout:
                                id: cart_list
                                orientation: "vertical"
                                adaptive_height: True
                                spacing: dp(8)
                                padding: [0, dp(4), 0, dp(4)]

                        MDLabel:
                            id: cart_empty_label
                            text: "O carrinho está vazio."
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: app.theme_tokens['manager_ink']
                            font_size: dp(16)
                            size_hint_y: None
                            height: dp(60)

            MDCard:
                id: summary_card
                size_hint_x: 0.26
                radius: [dp(18)]
                elevation: 2
                md_bg_color: app.theme_tokens['surface_alt']
                padding: [dp(12), dp(12), dp(12), dp(12)]
                spacing: dp(10)

                ScrollView:
                    id: summary_scroll
                    do_scroll_x: False
                    bar_width: dp(5)

                    MDBoxLayout:
                        id: summary_content
                        orientation: "vertical"
                        spacing: dp(8)
                        size_hint_y: None
                        height: self.minimum_height

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(30)

                            MDLabel:
                                text: "Pagamento"
                                bold: True
                                font_style: "H6"
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_primary']

                        MDCard:
                            id: total_final_card
                            orientation: "vertical"
                            size_hint_y: None
                            height: dp(82)
                            radius: [dp(16)]
                            elevation: 0
                            ripple_behavior: True
                            md_bg_color: app.theme_tokens['success'][0], app.theme_tokens['success'][1], app.theme_tokens['success'][2], 0.24
                            padding: [dp(14), dp(10), dp(14), dp(10)]
                            spacing: dp(2)
                            on_touch_up: root.on_total_final_card_touch(self, args[1])

                            MDLabel:
                                text: "Total a pagar"
                                font_size: dp(15)
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['manager_ink']

                            MDLabel:
                                id: total_value_label
                                text: "0.00 MT"
                                bold: True
                                font_style: "H4"
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_primary']

                        MDCard:
                            id: totals_detail_card
                            orientation: "vertical"
                            size_hint_y: None
                            height: dp(88)
                            radius: [dp(14)]
                            elevation: 0
                            md_bg_color: app.theme_tokens['card']
                            padding: [dp(12), dp(8), dp(12), dp(8)]
                            spacing: dp(4)

                            MDBoxLayout:
                                size_hint_y: None
                                height: dp(24)

                                MDLabel:
                                    text: "Subtotal"
                                    font_size: dp(14)
                                    theme_text_color: "Custom"
                                    text_color: app.theme_tokens['manager_ink']

                                MDLabel:
                                    id: subtotal_value_label
                                    text: "0.00 MT"
                                    halign: "right"
                                    bold: True
                                    font_size: dp(14)
                                    theme_text_color: "Custom"
                                    text_color: app.theme_tokens['text_primary']

                            MDBoxLayout:
                                size_hint_y: None
                                height: dp(38)
                                spacing: dp(8)

                                MDLabel:
                                    text: "Desconto"
                                    size_hint_x: 0.30
                                    font_size: dp(14)
                                    theme_text_color: "Custom"
                                    text_color: app.theme_tokens['manager_ink']

                                TooltipTextField:
                                    id: discount_input
                                    hint_text: "0.00"
                                    tooltip_text: "Desconto | Alt+D"
                                    multiline: False
                                    input_filter: "float"
                                    mode: "rectangle"
                                    size_hint_x: 0.40
                                    font_size: dp(15)
                                    line_color_normal: app.theme_tokens['divider']
                                    line_color_focus: app.theme_tokens['primary']
                                    on_text: root.on_discount_text(self.text)

                                MDLabel:
                                    id: discount_value_label
                                    text: "0.00 MT"
                                    halign: "right"
                                    size_hint_x: 0.30
                                    bold: True
                                    font_size: dp(14)
                                    theme_text_color: "Custom"
                                    text_color: app.theme_tokens['success']

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(24)

                            MDLabel:
                                text: "Forma de pagamento"
                                font_size: dp(15)
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['text_primary']

                            MDLabel:
                                text: "Alt+1..4"
                                halign: "right"
                                font_size: dp(14)
                                theme_text_color: "Custom"
                                text_color: app.theme_tokens['manager_ink']

                        MDGridLayout:
                            # O painel de resumo é compacto: as quatro opções
                            # de pagamento devem ficar sempre na mesma linha.
                            size_hint_y: None
                            height: self.minimum_height
                            cols: 4
                            spacing: dp(4)
                            row_default_height: dp(44)
                            row_force_default: True

                            TooltipRaisedButton:
                                id: pay_cash_btn
                                text: "Dinheiro"
                                tooltip_text: "Pagamento em dinheiro | Alt+1"
                                font_size: sp(13)
                                padding: [dp(6), 0]
                                size_hint_y: None
                                height: dp(42)
                                md_bg_color: app.theme_tokens['primary']
                                on_release: root.set_payment_method("cash")

                            TooltipRaisedButton:
                                id: pay_card_btn
                                text: "Cartão"
                                tooltip_text: "Pagamento com cartao | Alt+2"
                                font_size: sp(13)
                                padding: [dp(6), 0]
                                size_hint_y: None
                                height: dp(42)
                                md_bg_color: app.theme_tokens['card_alt']
                                on_release: root.set_payment_method("card")

                            TooltipRaisedButton:
                                id: pay_mobile_btn
                                text: "M-Pesa"
                                tooltip_text: "Pagamento M-Pesa | Alt+3"
                                font_size: sp(13)
                                padding: [dp(6), 0]
                                size_hint_y: None
                                height: dp(42)
                                md_bg_color: app.theme_tokens['card_alt']
                                on_release: root.set_payment_method("mobile")

                            TooltipRaisedButton:
                                id: pay_emola_btn
                                text: "E-MOLA"
                                tooltip_text: "Pagamento E-MOLA | Alt+4"
                                font_size: sp(13)
                                padding: [dp(6), 0]
                                size_hint_y: None
                                height: dp(42)
                                md_bg_color: app.theme_tokens['card_alt']
                                on_release: root.set_payment_method("emola")

                        MDCard:
                            orientation: "vertical"
                            size_hint_y: None
                            height: dp(96)
                            radius: [dp(16)]
                            elevation: 0
                            md_bg_color: app.theme_tokens['card']
                            padding: [dp(12), dp(10), dp(12), dp(10)]
                            spacing: dp(8)

                            MDBoxLayout:
                                size_hint_y: None
                                height: dp(18)

                                MDLabel:
                                    text: "Valor recebido"
                                    size_hint_x: 0.54
                                    bold: True
                                    font_size: dp(15)
                                    theme_text_color: "Custom"
                                    text_color: app.theme_tokens['text_primary']

                                MDLabel:
                                    text: "Troco"
                                    size_hint_x: 0.46
                                    halign: "center"
                                    bold: True
                                    font_size: dp(15)
                                    theme_text_color: "Custom"
                                    text_color: app.theme_tokens['text_primary']

                            MDBoxLayout:
                                size_hint_y: None
                                height: dp(48)
                                spacing: dp(8)

                                TooltipTextField:
                                    id: paid_input
                                    hint_text: "Valor pago (obrigatório)"
                                    tooltip_text: "Valor pago | Alt+V"
                                    multiline: False
                                    input_filter: "float"
                                    mode: "rectangle"
                                    font_size: dp(16)
                                    line_color_normal: app.theme_tokens['divider']
                                    line_color_focus: app.theme_tokens['primary']
                                    on_text: root.calculate_change()

                                MDCard:
                                    size_hint_x: 0.46
                                    radius: [dp(12)]
                                    elevation: 0
                                    md_bg_color: app.theme_tokens['success'][0], app.theme_tokens['success'][1], app.theme_tokens['success'][2], 0.13
                                    padding: [dp(6), 0, dp(6), 0]

                                    MDLabel:
                                        id: change_value_label
                                        text: "0.00 MT"
                                        halign: "center"
                                        valign: "middle"
                                        text_size: self.size
                                        bold: True
                                        font_size: dp(16)
                                        theme_text_color: "Custom"
                                        text_color: app.theme_tokens['success']

                        MDCard:
                            orientation: "vertical"
                            size_hint_y: None
                            height: dp(86)
                            radius: [dp(16)]
                            elevation: 0
                            md_bg_color: app.theme_tokens['card']
                            padding: [dp(12), dp(8), dp(12), dp(10)]
                            spacing: dp(6)

                            MDLabel:
                                text: "Notas rápidas (MT)"
                                size_hint_y: None
                                height: dp(18)
                                bold: True
